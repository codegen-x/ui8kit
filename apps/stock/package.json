{
  "name": "stock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Stock: a stock-site storefront over the kit's blocks (474 variants of 92 specs) and the 65 composed screen pages: search, type tabs, quick filters, a facet column with disjunctive counts, applied-filter chips, sort, pages of live previews that follow the Theme, in en/fr/de/es/ru. The app assembles @ui8kit/layouts (structure), @ui8kit/facet-search (engine), its data (content/) and routes; it is not generated by compose-gen.",
  "ui8kit": {
    "runtime": "svelte",
    "kit": [],
    "composition": [
      "src"
    ],
    "blockRoot": []
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test src scripts",
    "index": "bun scripts/build-index.ts",
    "index:check": "bun scripts/build-index.ts --check"
  },
  "dependencies": {
    "@codegen-x/svelte-compose": "workspace:*",
    "@ui8kit/app-shared": "workspace:*",
    "@ui8kit/facet-search": "workspace:*",
    "@ui8kit/layouts": "workspace:*",
    "@ui8kit/panorama": "workspace:*",
    "@ui8kit/taste-data": "workspace:*",
    "@ui8kit/theme-model": "workspace:*",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
