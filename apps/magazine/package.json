{
  "name": "magazine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Magazine: the journal of a visitor's taste. Opened from Discovery (?cards=recommend) with the 10 picked styles, it shows recommendation rows; opened directly it shows only the rotating sphere. Hand-written app, not generated by compose-gen.",
  "ui8kit": {
    "runtime": "svelte",
    "kit": [
      "src/lib"
    ],
    "composition": [
      "src/App.svelte",
      "src/reference",
      "src/parts",
      "src/feed",
      "src/templates"
    ],
    "blockRoot": [
      "src/App.svelte",
      "src/reference",
      "src/templates"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test src",
    "css-parity": "bash scripts/css-parity.sh",
    "e2e:persist": "bun scripts/e2e-persist.mjs",
    "e2e:feed": "bun scripts/e2e-feed.ts",
    "e2e:theme": "bun scripts/e2e-theme-sync.mjs"
  },
  "dependencies": {
    "@ui8kit/app-shared": "workspace:*",
    "@ui8kit/layouts": "workspace:*",
    "@ui8kit/panorama": "workspace:*",
    "@codegen-x/svelte-compose": "workspace:*",
    "@ui8kit/taste-data": "workspace:*",
    "@ui8kit/theme-model": "workspace:*",
    "@ui8kit/taste-screens": "workspace:*",
    "svelte": "^5.57.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.2",
    "@types/three": "^0.186.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "playwright-core": "^1.63.0",
    "html-validate": "^11.16.2"
  }
}
