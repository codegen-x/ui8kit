{
  "name": "discovery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Discovery: a Three.js panorama of hand-written taste screens (skin + fonts + radius + composition + procedural image). Hand-written app, not generated by xgen.",
  "ui8kit": {
    "runtime": "svelte",
    "kit": [],
    "composition": [
      "src/App.svelte",
      "src/parts"
    ],
    "blockRoot": [
      "src/parts/panorama-view.svelte",
      "src/parts/screen-preview.svelte",
      "src/parts/theme-corner.svelte"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "included": "bun scripts/included.ts",
    "rules": "xgen-rules"
  },
  "dependencies": {
    "@ui8kit/app-shared": "workspace:*",
    "@ui8kit/panorama": "workspace:*",
    "@codegen-x/svelte-compose": "workspace:*",
    "@ui8kit/taste-data": "workspace:*",
    "svelte": "^5.57.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/three": "^0.186.0",
    "@ui8kit/xgen-tooling": "workspace:*",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
