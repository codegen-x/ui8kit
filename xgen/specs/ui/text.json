{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.text",
  "tier": "brick",
  "dir": "text",
  "docs": "Text renders a paragraph of body copy. Use Inline for inline span copy\nand Title (as 1–6) for headings.",
  "variants": {
    "text": "text.variants.json"
  },
  "parts": [
    {
      "name": "Text",
      "docs": "Text renders a p element with body copy classes.",
      "recipeId": "text",
      "asChild": true,
      "classes": {
        "recipe": {
          "size": "Size",
          "weight": "Weight"
        }
      },
      "props": [
        {
          "name": "Size",
          "type": "string",
          "cva": true,
          "docs": "sets size"
        },
        {
          "name": "Weight",
          "type": "string",
          "cva": true,
          "docs": "sets weight"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "static",
          "tag": "p"
        },
        "attrs": [
          {
            "kind": "class"
          },
          {
            "kind": "rest"
          }
        ],
        "children": [
          {
            "kind": "slot"
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "p"
        ],
        "roles": [],
        "aria": [],
        "keyboard": []
      },
      "data": [],
      "tokens": []
    }
  ],
  "examples": [
    {
      "id": "default",
      "props": {}
    },
    {
      "id": "muted",
      "props": {
        "Class": "text-muted-foreground"
      }
    },
    {
      "id": "code",
      "props": {
        "Class": "text-sm font-mono"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
