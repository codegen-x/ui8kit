{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.faq-help",
  "name": "FaqHelp",
  "docs": "The help card beside the questions of FaqSplit: a title, a line of text, the ways to reach the team (icon, name, one line) and a link.",
  "records": {},
  "props": [
    {
      "name": "labels",
      "type": {
        "ts": "FaqSplitLabels"
      },
      "required": true
    },
    {
      "name": "channels",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "aside",
        "Class": "rounded bg-card inset-ring inset-ring-border flex flex-col gap-6 p-6"
      },
      "attrs": {
        "aria-label": {
          "$": "labels.asideTitle"
        },
        "data-testid": "faq-help"
      },
      "children": [
        {
          "use": "Stack",
          "props": {
            "Gap": "2"
          },
          "children": [
            {
              "use": "Text",
              "props": {
                "Size": "lg",
                "Weight": "semibold"
              },
              "children": [
                {
                  "text": {
                    "$": "labels.asideTitle"
                  }
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Class": "text-muted-foreground"
              },
              "children": [
                {
                  "text": {
                    "$": "labels.asideText"
                  }
                }
              ]
            }
          ]
        },
        {
          "use": "List",
          "props": {
            "Class": "m-0 flex list-none flex-col gap-4 p-0"
          },
          "children": [
            {
              "each": {
                "$": "channels"
              },
              "as": "c",
              "key": {
                "$": "c.id"
              },
              "do": [
                {
                  "use": "ListItem",
                  "props": {
                    "Class": "flex items-start gap-4"
                  },
                  "attrs": {
                    "data-testid": "faq-channel"
                  },
                  "children": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "c.icon"
                            },
                            "Size": 20
                          }
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "c.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "c.text"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "use": "Link",
          "props": {
            "Href": "#/contact",
            "Variant": "default",
            "Size": "sm",
            "Class": "font-medium"
          },
          "children": [
            {
              "text": {
                "$": "labels.asideCta"
              }
            },
            {
              "use": "LucideIcon",
              "props": {
                "Name": "arrow-right",
                "Size": 16
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "frame": true,
  "typeImports": [
    {
      "from": "FaqSplit",
      "names": [
        "Question",
        "FaqSplitLabels"
      ]
    },
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    }
  ]
}
