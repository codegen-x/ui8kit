{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.quote-split",
  "name": "QuoteSplit",
  "docs": "Testimonials in a split or with figures. Axes: layout (media: one quote card and an action beside a picture, logos: one quote over four logo tiles beside a picture, rating: one quote beside a rating panel, stack: three stacked quote cards beside a picture, compact: four short quote cards in a row, bento: figures over a featured quote beside a stack), mediaSide, tone.",
  "records": {
    "QuoteExtras": [
      {
        "name": "stats",
        "type": "Stat[]"
      },
      {
        "name": "logos",
        "type": "Logo[]"
      },
      {
        "name": "rating",
        "type": "number"
      },
      {
        "name": "score",
        "type": "string"
      },
      {
        "name": "reviews",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "badge",
      "type": "string",
      "default": "",
      "docs": "a short pill above the heading"
    },
    {
      "name": "quotes",
      "type": {
        "ts": "Quote[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "QuoteLabels"
      },
      "required": true
    },
    {
      "name": "extras",
      "type": {
        "record": "QuoteExtras"
      },
      "required": true
    },
    {
      "name": "actions",
      "type": {
        "ts": "LinkActions"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"media\" | \"logos\" | \"rating\" | \"stack\" | \"compact\" | \"bento\""
      },
      "default": "media"
    },
    {
      "name": "mediaSide",
      "type": {
        "ts": "\"end\" | \"start\""
      },
      "default": "end"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "compact"
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "bento"
            ]
          }
        ]
      },
      "then": [
        {
          "organism": "SectionFrame",
          "props": {
            "id": {
              "$": "id"
            },
            "title": {
              "$": "title"
            },
            "lead": {
              "$": "lead"
            },
            "heading": {
              "badge": {
                "$": "badge"
              }
            },
            "tone": {
              "$": "tone"
            },
            "density": "default"
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "bento"
                    ]
                  },
                  "then": [
                    {
                      "organism": "QuoteFigures",
                      "props": {
                        "extras": {
                          "$": "extras"
                        }
                      }
                    }
                  ]
                },
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "bento"
                          ]
                        },
                        "grid grid-cols-1 gap-4 lg:grid-cols-2",
                        "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
                      ]
                    }
                  },
                  "children": [
                    {
                      "each": {
                        "$": "quotes"
                      },
                      "as": "q",
                      "key": {
                        "$": "q.id"
                      },
                      "do": [
                        {
                          "organism": "QuoteSlot",
                          "props": {
                            "q": {
                              "$": "q"
                            },
                            "labels": {
                              "$": "labels"
                            },
                            "kind": "card",
                            "layout": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "and",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "bento"
                                      ]
                                    },
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "i"
                                        },
                                        0
                                      ]
                                    }
                                  ]
                                },
                                "single",
                                "grid"
                              ]
                            },
                            "className": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "and",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "bento"
                                      ]
                                    },
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "i"
                                        },
                                        0
                                      ]
                                    }
                                  ]
                                },
                                "lg:row-span-3",
                                ""
                              ]
                            }
                          }
                        }
                      ],
                      "index": "i"
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "else": [
        {
          "organism": "SectionFrame",
          "props": {
            "id": {
              "$": "id"
            },
            "title": {
              "$": "title"
            },
            "lead": {
              "$": "lead"
            },
            "heading": {
              "badge": {
                "$": "badge"
              }
            },
            "tone": {
              "$": "tone"
            },
            "density": "default",
            "layout": "split",
            "media": {
              "show": true,
              "side": {
                "$": "mediaSide"
              }
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "when": {
                    "op": "or",
                    "args": [
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "media"
                        ]
                      },
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "logos"
                        ]
                      },
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "rating"
                        ]
                      }
                    ]
                  },
                  "then": [
                    {
                      "each": {
                        "$": "quotes"
                      },
                      "as": "q",
                      "key": {
                        "$": "q.id"
                      },
                      "do": [
                        {
                          "when": {
                            "op": "lt",
                            "args": [
                              {
                                "$": "i"
                              },
                              1
                            ]
                          },
                          "then": [
                            {
                              "organism": "QuoteSlot",
                              "props": {
                                "q": {
                                  "$": "q"
                                },
                                "labels": {
                                  "$": "labels"
                                },
                                "kind": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "media"
                                      ]
                                    },
                                    "card",
                                    "plain"
                                  ]
                                },
                                "layout": "single",
                                "className": ""
                              }
                            }
                          ]
                        }
                      ],
                      "index": "i"
                    }
                  ]
                },
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "logos"
                    ]
                  },
                  "then": [
                    {
                      "organism": "QuoteLogoTiles",
                      "props": {
                        "extras": {
                          "$": "extras"
                        }
                      }
                    }
                  ]
                },
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "stack"
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "quotes"
                          },
                          "as": "q",
                          "key": {
                            "$": "q.id"
                          },
                          "do": [
                            {
                              "when": {
                                "op": "lt",
                                "args": [
                                  {
                                    "$": "i"
                                  },
                                  3
                                ]
                              },
                              "then": [
                                {
                                  "organism": "QuoteSlot",
                                  "props": {
                                    "q": {
                                      "$": "q"
                                    },
                                    "labels": {
                                      "$": "labels"
                                    },
                                    "kind": "card",
                                    "layout": "stack",
                                    "className": ""
                                  }
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "or",
                    "args": [
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "media"
                        ]
                      },
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "logos"
                        ]
                      },
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "rating"
                        ]
                      }
                    ]
                  },
                  "then": [
                    {
                      "organism": "ActionGroup",
                      "props": {
                        "primary": {
                          "$": "actions.cta"
                        },
                        "primaryHref": {
                          "$": "actions.href"
                        },
                        "secondary": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "actions.mode"
                                },
                                "two"
                              ]
                            },
                            {
                              "$": "actions.secondary"
                            },
                            {
                              "op": "undef",
                              "args": []
                            }
                          ]
                        },
                        "secondaryHref": {
                          "$": "actions.secondaryHref"
                        },
                        "align": "start"
                      }
                    }
                  ]
                }
              ]
            },
            "aside": {
              "args": [],
              "do": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "rating"
                    ]
                  },
                  "then": [
                    {
                      "organism": "QuoteRatingPanel",
                      "props": {
                        "extras": {
                          "$": "extras"
                        },
                        "labels": {
                          "$": "labels"
                        }
                      }
                    }
                  ],
                  "else": [
                    {
                      "organism": "MediaFrame",
                      "props": {
                        "alt": {
                          "$": "title"
                        },
                        "ratio": "4/3"
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "TestimonialGrid",
      "names": [
        "Quote",
        "QuoteLabels"
      ]
    },
    {
      "from": "StatsBand",
      "names": [
        "Stat"
      ]
    },
    {
      "from": "LogoCloud",
      "names": [
        "Logo"
      ]
    },
    {
      "from": "ErrorPage",
      "names": [
        "LinkActions"
      ]
    }
  ]
}
