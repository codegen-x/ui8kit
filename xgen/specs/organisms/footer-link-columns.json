{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.footer-link-columns",
  "name": "FooterLinkColumns",
  "docs": "The first three link groups of FooterSplit as small columns beside each other.",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "docs": "accessible name of the link groups"
    },
    {
      "name": "groups",
      "type": {
        "ts": "MegaGroup[]"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "nav"
      },
      "attrs": {
        "aria-label": {
          "$": "label"
        }
      },
      "children": [
        {
          "use": "Box",
          "props": {
            "Class": "grid grid-cols-2 gap-8 sm:grid-cols-3"
          },
          "children": [
            {
              "each": {
                "$": "groups"
              },
              "as": "g",
              "key": {
                "$": "g.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      3
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "2"
                      },
                      "attrs": {
                        "data-testid": "group"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "g.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "List",
                          "props": {
                            "Class": "m-0 flex list-none flex-col gap-2 p-0"
                          },
                          "children": [
                            {
                              "each": {
                                "$": "g.links"
                              },
                              "as": "item",
                              "key": {
                                "$": "item"
                              },
                              "do": [
                                {
                                  "use": "ListItem",
                                  "children": [
                                    {
                                      "use": "Link",
                                      "props": {
                                        "Href": "#/",
                                        "Variant": "muted",
                                        "Size": "sm",
                                        "Class": ""
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "item"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "MegaMenu",
      "names": [
        "MegaGroup"
      ]
    }
  ]
}
