{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.nav-block",
  "name": "NavBlock",
  "docs": "A navigation region in its own file: Block tag nav named by `label`.",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "docs": "accessible name of the navigation"
    },
    {
      "name": "testid",
      "type": "string",
      "docs": "data-testid of the root"
    }
  ],
  "className": true,
  "children": true,
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "nav",
        "Class": {
          "op": "cn",
          "args": [
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "aria-label": {
          "$": "label"
        },
        "data-testid": {
          "$": "testid"
        }
      },
      "children": [
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
