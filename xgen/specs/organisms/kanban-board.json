{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.kanban-board",
  "name": "KanbanBoard",
  "docs": "Work items in lanes. Each lane has a title, a count and its cards; a card has a title, an optional tag and the person it belongs to. Axes: card (simple, detail: tag and person), cols (2, 3), tone, density. Moving a card between lanes is a port contract.",
  "records": {
    "Lane": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "key",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      }
    ],
    "BoardCard": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "lane",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "tag",
        "type": "string"
      },
      {
        "name": "who",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lanes",
      "type": {
        "ts": "Lane[]"
      },
      "required": true
    },
    {
      "name": "cards",
      "type": {
        "ts": "BoardCard[]"
      },
      "required": true
    },
    {
      "name": "countLabel",
      "type": "string",
      "required": true,
      "docs": "template of the card count of a lane, e.g. `{0} cards`"
    },
    {
      "name": "card",
      "type": {
        "ts": "\"simple\" | \"detail\""
      },
      "default": "detail"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"2\" | \"3\""
      },
      "default": "3"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Grid",
              "props": {
                "Cols": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "cols"
                        },
                        "2"
                      ]
                    },
                    "1-2",
                    "1-3"
                  ]
                },
                "Class": "items-start gap-4"
              },
              "attrs": {
                "data-testid": "lanes"
              },
              "children": [
                {
                  "each": {
                    "$": "lanes"
                  },
                  "as": "lane",
                  "key": {
                    "$": "lane.id"
                  },
                  "do": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch",
                        "Class": "rounded bg-muted p-4"
                      },
                      "attrs": {
                        "data-testid": "lane"
                      },
                      "children": [
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "2",
                            "Align": "center",
                            "Justify": "between"
                          },
                          "children": [
                            {
                              "use": "Title",
                              "props": {
                                "As": 3,
                                "Size": "base",
                                "Weight": "bold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "lane.title"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "op": "tpl",
                                    "args": [
                                      {
                                        "$": "countLabel"
                                      },
                                      {
                                        "op": "len",
                                        "args": [
                                          {
                                            "op": "where",
                                            "args": [
                                              {
                                                "$": "cards"
                                              },
                                              "lane",
                                              {
                                                "$": "lane.key"
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "List",
                          "props": {
                            "Class": "m-0 flex list-none flex-col gap-2 p-0"
                          },
                          "children": [
                            {
                              "each": {
                                "op": "where",
                                "args": [
                                  {
                                    "$": "cards"
                                  },
                                  "lane",
                                  {
                                    "$": "lane.key"
                                  }
                                ]
                              },
                              "as": "c",
                              "key": {
                                "$": "c.id"
                              },
                              "do": [
                                {
                                  "use": "ListItem",
                                  "props": {
                                    "Class": {
                                      "op": "cn",
                                      "args": [
                                        "flex flex-col rounded bg-card inset-ring inset-ring-border",
                                        {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "density"
                                                },
                                                "compact"
                                              ]
                                            },
                                            "gap-2 p-2",
                                            "gap-2 p-4"
                                          ]
                                        }
                                      ]
                                    }
                                  },
                                  "attrs": {
                                    "data-testid": "item"
                                  },
                                  "children": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Weight": "semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "c.title"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "when": {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "$": "card"
                                          },
                                          "detail"
                                        ]
                                      },
                                      "then": [
                                        {
                                          "use": "Group",
                                          "props": {
                                            "Gap": "2",
                                            "Align": "center",
                                            "Justify": "between",
                                            "Class": "flex-wrap"
                                          },
                                          "children": [
                                            {
                                              "organism": "Pill",
                                              "props": {
                                                "tone": "blue",
                                                "icon": "tag"
                                              },
                                              "slots": {
                                                "children": {
                                                  "args": [],
                                                  "do": [
                                                    {
                                                      "text": {
                                                        "$": "c.tag"
                                                      }
                                                    }
                                                  ]
                                                }
                                              }
                                            },
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "xs",
                                                "Class": "text-muted-foreground"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "c.who"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
