{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.feature-accordion",
  "name": "FeatureAccordion",
  "docs": "Features as a list of disclosures: icon and title in the summary, the text when open. Axes: expand (first: the first one is open, none: all closed), media (none, image: a picture beside the list), tone, density.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "features",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    },
    {
      "name": "expand",
      "type": {
        "ts": "\"first\" | \"none\""
      },
      "default": "first"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"none\" | \"image\""
      },
      "default": "none"
    },
    {
      "name": "multiple",
      "type": "boolean",
      "default": false,
      "docs": "true: several can be open at once; false: opening one closes the others (native details name)"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "layout": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "media"
                },
                "image"
              ]
            },
            "split",
            "stack"
          ]
        },
        "media": {
          "show": {
            "op": "eq",
            "args": [
              {
                "$": "media"
              },
              "image"
            ]
          }
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Stack",
              "props": {
                "Gap": "0",
                "Align": "stretch"
              },
              "attrs": {
                "data-testid": "items"
              },
              "children": [
                {
                  "each": {
                    "$": "features"
                  },
                  "as": "f",
                  "key": {
                    "$": "f.id"
                  },
                  "do": [
                    {
                      "use": "Disclosure",
                      "props": {
                        "Variant": "item",
                        "Name": {
                          "op": "cond",
                          "args": [
                            {
                              "$": "multiple"
                            },
                            {
                              "op": "undef",
                              "args": []
                            },
                            {
                              "op": "tpl",
                              "args": [
                                "{0}-accordion",
                                {
                                  "op": "coalesce",
                                  "args": [
                                    {
                                      "$": "id"
                                    },
                                    "accordion"
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        "Open": {
                          "op": "and",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "expand"
                                },
                                "first"
                              ]
                            },
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "i"
                                },
                                0
                              ]
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "item"
                      },
                      "children": [
                        {
                          "use": "Summary",
                          "props": {
                            "Variant": "item"
                          },
                          "children": [
                            {
                              "use": "Group",
                              "props": {
                                "Tag": "span",
                                "Gap": "4",
                                "Align": "center"
                              },
                              "children": [
                                {
                                  "use": "LucideIcon",
                                  "props": {
                                    "Name": {
                                      "$": "f.icon"
                                    },
                                    "Size": 20
                                  }
                                },
                                {
                                  "use": "Inline",
                                  "props": {
                                    "Class": "text-base font-semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "f.title"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Class": "pb-4 text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "f.text"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "index": "i"
                }
              ]
            }
          ]
        },
        "aside": {
          "args": [],
          "do": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "title"
                },
                "ratio": "4/3"
              }
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    }
  ]
}
