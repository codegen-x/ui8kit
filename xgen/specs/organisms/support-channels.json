{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.support-channels",
  "name": "SupportChannels",
  "docs": "Ways to get help as cards or rows, each with an icon, a title, a sentence and an open link. Axes: layout (grid, list), columns, action (link, none), tone (default, muted).",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "channels",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    },
    {
      "name": "open",
      "type": "string",
      "required": true,
      "docs": "text of the link of each channel"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"list\""
      },
      "default": "grid"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1-2\" | \"1-3\""
      },
      "default": "1-3"
    },
    {
      "name": "action",
      "type": {
        "ts": "\"link\" | \"none\""
      },
      "default": "link"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Grid",
              "props": {
                "Cols": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "layout"
                        },
                        "list"
                      ]
                    },
                    "1",
                    {
                      "$": "cols"
                    }
                  ]
                },
                "Class": "gap-4"
              },
              "attrs": {
                "data-testid": "items"
              },
              "children": [
                {
                  "each": {
                    "$": "channels"
                  },
                  "as": "c",
                  "key": {
                    "$": "c.id"
                  },
                  "do": [
                    {
                      "use": "Card",
                      "props": {
                        "Variant": "default",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "h-full",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "layout"
                                    },
                                    "list"
                                  ]
                                },
                                "flex-row items-center",
                                ""
                              ]
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "item"
                      },
                      "children": [
                        {
                          "use": "CardContent",
                          "props": {
                            "Class": {
                              "op": "cn",
                              "args": [
                                "flex flex-1 gap-4",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "list"
                                      ]
                                    },
                                    "items-center",
                                    "flex-col"
                                  ]
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "$": "c.icon"
                                },
                                "Size": 24
                              }
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2",
                                "Class": "flex-1"
                              },
                              "children": [
                                {
                                  "use": "Title",
                                  "props": {
                                    "As": 3,
                                    "Size": "base",
                                    "Weight": "bold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "c.title"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "c.text"
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "when": {
                                "op": "eq",
                                "args": [
                                  {
                                    "$": "action"
                                  },
                                  "link"
                                ]
                              },
                              "then": [
                                {
                                  "use": "Link",
                                  "props": {
                                    "Href": "#/",
                                    "Variant": "default"
                                  },
                                  "attrs": {
                                    "data-testid": "open"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "open"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    }
  ]
}
