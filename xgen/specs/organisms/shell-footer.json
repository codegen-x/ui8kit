{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.shell-footer",
  "name": "ShellFooter",
  "docs": "The footer of DashboardShell: the copyright and a row of links, under the content column (inset) or across the whole shell (full).",
  "records": {},
  "props": [
    {
      "name": "nav",
      "type": {
        "ts": "ShellNav"
      },
      "required": true,
      "docs": "the brand, the links and the texts of the shell"
    },
    {
      "name": "place",
      "type": {
        "ts": "\"full\" | \"inset\""
      },
      "default": "full"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "footer",
        "Class": {
          "op": "cn",
          "args": [
            "flex shrink-0 flex-wrap items-center justify-between gap-4 border-t border-border px-6 py-4",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "place"
                    },
                    "full"
                  ]
                },
                "bg-card",
                ""
              ]
            }
          ]
        }
      },
      "attrs": {
        "data-testid": "footer",
        "data-place": {
          "$": "place"
        }
      },
      "children": [
        {
          "use": "Text",
          "props": {
            "Size": "xs",
            "Class": "text-muted-foreground"
          },
          "children": [
            {
              "text": {
                "$": "nav.copyright"
              }
            }
          ]
        },
        {
          "organism": "NavBlock",
          "props": {
            "label": {
              "$": "nav.footerLabel"
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "use": "List",
                  "props": {
                    "Class": "m-0 flex list-none items-center gap-4 p-0"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "nav.footer"
                      },
                      "as": "f",
                      "key": {
                        "$": "f.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "children": [
                            {
                              "use": "Link",
                              "props": {
                                "Href": "#/",
                                "Variant": "muted",
                                "Size": "sm",
                                "Class": "text-xs"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "f.name"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "frame": true,
  "typeImports": [
    {
      "from": "DashboardShell",
      "names": [
        "ShellNav"
      ]
    }
  ]
}
