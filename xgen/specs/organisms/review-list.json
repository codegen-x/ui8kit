{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.review-list",
  "name": "ReviewList",
  "docs": "Customer reviews as cards or plain entries: rating, title, text, author and date. Axes: layout (list, grid), columns, item (card, plain), avatar (none, image), tone, density.",
  "records": {
    "Review": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "author",
        "type": "string"
      },
      {
        "name": "rating",
        "type": "number"
      },
      {
        "name": "text",
        "type": "string"
      },
      {
        "name": "date",
        "type": "string"
      }
    ],
    "ReviewLabels": [
      {
        "name": "ratingLabel",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "reviews",
      "type": {
        "ts": "Review[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "record": "ReviewLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"list\" | \"grid\""
      },
      "default": "list"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"card\" | \"plain\""
      },
      "default": "card"
    },
    {
      "name": "avatar",
      "type": {
        "ts": "\"none\" | \"image\""
      },
      "default": "none"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"roomy\""
      },
      "default": "default"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "measure": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "list"
              ]
            },
            "2xl",
            "default"
          ]
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Grid",
              "props": {
                "Cols": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "layout"
                        },
                        "grid"
                      ]
                    },
                    "1-3",
                    "1"
                  ]
                },
                "Class": "gap-4"
              },
              "attrs": {
                "data-testid": "items"
              },
              "children": [
                {
                  "each": {
                    "$": "reviews"
                  },
                  "as": "r",
                  "key": {
                    "$": "r.id"
                  },
                  "do": [
                    {
                      "use": "Block",
                      "props": {
                        "Tag": "article",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "flex h-full flex-col gap-4",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "item"
                                    },
                                    "card"
                                  ]
                                },
                                "rounded bg-card p-6 inset-ring inset-ring-border",
                                "border-b border-border pb-4"
                              ]
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "item"
                      },
                      "children": [
                        {
                          "organism": "Rating",
                          "props": {
                            "value": {
                              "$": "r.rating"
                            },
                            "label": {
                              "op": "tpl",
                              "args": [
                                {
                                  "$": "labels.ratingLabel"
                                },
                                {
                                  "$": "r.rating"
                                }
                              ]
                            },
                            "size": 16
                          }
                        },
                        {
                          "use": "Title",
                          "props": {
                            "As": 3,
                            "Size": "base",
                            "Weight": "bold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "r.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "r.text"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "4",
                            "Align": "center",
                            "Class": "mt-auto"
                          },
                          "children": [
                            {
                              "when": {
                                "op": "eq",
                                "args": [
                                  {
                                    "$": "avatar"
                                  },
                                  "image"
                                ]
                              },
                              "then": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "r.author"
                                    },
                                    "ratio": "1/1",
                                    "className": "size-10 shrink-0 rounded-full"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "0"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "r.author"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "xs",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "r.date"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
