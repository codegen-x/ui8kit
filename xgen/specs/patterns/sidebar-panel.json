{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.sidebar-panel",
  "name": "SidebarPanel",
  "docs": "The app sidebar panel: width, padding and gap per kit sidebar type. Colours come from the middle layer.",
  "records": {},
  "props": [
    {
      "name": "variant",
      "type": {
        "ts": "\"chat\" | \"creator\""
      },
      "docs": "sidebar type"
    }
  ],
  "className": true,
  "children": true,
  "recipes": {
    "sidebarPanel": "sidebar-panel"
  },
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "aside",
        "Class": {
          "op": "cn",
          "args": [
            {
              "op": "recipe",
              "args": [
                "sidebarPanel",
                "variant",
                {
                  "$": "variant"
                }
              ]
            },
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "data-slot": "sidebar-panel",
        "data-variant": {
          "op": "coalesce",
          "args": [
            {
              "$": "variant"
            },
            "chat"
          ]
        }
      },
      "children": [
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "frame": true,
  "examples": [
    {
      "id": "variant.chat",
      "props": {
        "variant": "chat"
      }
    },
    {
      "id": "variant.creator",
      "props": {
        "variant": "creator"
      }
    }
  ]
}
