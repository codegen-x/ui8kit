{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.herosimple",
  "name": "Simple hero",
  "docs": "A badge, the heading, one paragraph and up to two links as the actions (primary, then secondary), with one picture at the end, at the start or on top, in a box or split to the edge of the screen.",
  "theme": "marketing",
  "group": "hero",
  "organism": "HeroSimple",
  "line": "simple",
  "model": "hero@1",
  "axes": {
    "media": [
      "end",
      "start",
      "top"
    ],
    "frame": [
      "box",
      "split"
    ]
  },
  "defaults": {
    "media": "end",
    "frame": "box"
  },
  "variants": [
    {
      "id": "mediaEnd",
      "set": {}
    },
    {
      "id": "mediaStart",
      "set": {
        "media": "start"
      }
    },
    {
      "id": "mediaTop",
      "set": {
        "media": "top"
      },
      "props": {
        "align": "center"
      }
    },
    {
      "id": "splitEnd",
      "set": {
        "frame": "split"
      }
    },
    {
      "id": "splitStart",
      "set": {
        "media": "start",
        "frame": "split"
      }
    }
  ],
  "slots": [
    "MediaFrame"
  ],
  "facts": [
    {
      "sel": "section[aria-labelledby] h2",
      "n": 1
    },
    {
      "sel": "[data-slot=\"badge\"]",
      "n": 1
    },
    {
      "sel": "a[data-slot=\"button\"][href]",
      "n": 2
    },
    {
      "sel": "button",
      "n": 0
    },
    {
      "sel": "[data-slot=\"media-frame\"]",
      "n": 1
    }
  ],
  "data": [],
  "sample": {
    "props": {
      "id": "herosimple",
      "badge": {
        "$": "ui.marketing.heroSimple.badge"
      },
      "title": {
        "$": "ui.marketing.heroSimple.title"
      },
      "description": {
        "$": "ui.marketing.heroSimple.description"
      },
      "imageAlt": {
        "$": "ui.marketing.heroSimple.imageAlt"
      },
      "actionLabel": {
        "$": "ui.marketing.heroSimple.actionLabel"
      },
      "actionHref": "#/start",
      "secondaryActionLabel": {
        "$": "ui.marketing.heroSimple.secondaryActionLabel"
      },
      "secondaryActionHref": "#/tour"
    }
  }
}
