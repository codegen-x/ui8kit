{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.posts",
  "name": "Blog posts",
  "docs": "Posts as a grid, a list or a magazine.",
  "theme": "content",
  "group": "blog",
  "organism": "PostGrid",
  "axes": {
    "layout": [
      "grid",
      "list",
      "magazine"
    ],
    "cols": [
      "1-2",
      "1-3",
      "1-4"
    ],
    "media": [
      "image",
      "none"
    ],
    "meta": [
      "full",
      "short",
      "news"
    ],
    "filter.mode": [
      "none",
      "topics"
    ],
    "pager.mode": [
      "none",
      "pages"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "grid",
    "cols": "1-3",
    "media": "image",
    "meta": "full",
    "filter.mode": "none",
    "pager.mode": "none",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "grid",
      "set": {}
    },
    {
      "id": "filters",
      "set": {
        "filter.mode": "topics"
      },
      "props": {
        "filter": {
          "topic": "Design"
        }
      }
    },
    {
      "id": "twoUp",
      "set": {
        "cols": "1-2"
      }
    },
    {
      "id": "row4",
      "set": {
        "cols": "1-4"
      }
    },
    {
      "id": "news4",
      "set": {
        "cols": "1-4",
        "meta": "news"
      },
      "props": {
        "action": {
          "label": {
            "$": "ui.content.posts.action"
          },
          "href": "#/"
        }
      }
    },
    {
      "id": "list",
      "set": {
        "layout": "list"
      }
    },
    {
      "id": "listPaged",
      "set": {
        "layout": "list",
        "pager.mode": "pages"
      },
      "props": {
        "pager": {
          "page": 2,
          "pages": 5
        }
      }
    },
    {
      "id": "listLinks",
      "set": {
        "layout": "list",
        "media": "none",
        "pager.mode": "pages"
      },
      "props": {
        "pager": {
          "page": 1,
          "pages": 5,
          "url": "?paged={0}",
          "firstUrl": "./"
        }
      }
    },
    {
      "id": "magazine",
      "set": {
        "layout": "magazine"
      }
    },
    {
      "id": "textOnly",
      "set": {
        "media": "none"
      }
    },
    {
      "id": "digest",
      "set": {
        "meta": "short",
        "density": "compact",
        "tone": "muted",
        "media": "none"
      }
    }
  ],
  "slots": [
    "Pager",
    "SectionFrame",
    "Switcher",
    "SwitcherItem"
  ],
  "facts": [
    {
      "sel": "nav[aria-label][data-testid=\"posts-pager\"]",
      "n": 1,
      "when": {
        "pager.mode": "pages"
      }
    },
    {
      "sel": "[data-testid=\"posts-pager\"] [aria-current=\"page\"]",
      "n": 1,
      "when": {
        "pager.mode": "pages"
      }
    },
    {
      "sel": "[data-testid=\"posts-pager\"]",
      "n": 0,
      "when": {
        "pager.mode": "none"
      }
    },
    {
      "sel": "[data-testid=\"posts-pager\"] a",
      "n": 0,
      "when": {
        "pager.mode": "pages",
        "media": "image"
      }
    },
    {
      "sel": "[data-testid=\"posts-pager\"] a[href]",
      "n": 3,
      "when": {
        "pager.mode": "pages",
        "media": "none"
      }
    },
    {
      "sel": "[data-testid=\"posts-pager\"] a[aria-current]",
      "n": 0,
      "when": {
        "pager.mode": "pages",
        "media": "none"
      }
    },
    {
      "sel": "[data-testid=\"posts-pager\"] button[disabled]:not([href])",
      "n": 1,
      "when": {
        "pager.mode": "pages",
        "media": "none"
      }
    },
    {
      "sel": "[data-testid=\"posts-pager\"] button",
      "n": 1,
      "when": {
        "pager.mode": "pages",
        "media": "none"
      }
    }
  ],
  "data": [
    {
      "as": "posts",
      "collection": "posts",
      "kind": "post",
      "record": "Post",
      "fields": {
        "id": "id",
        "title": "title",
        "excerpt": "excerpt",
        "category": "terms|term:category",
        "author": "author_id|author",
        "date": "metadata.date.value|date",
        "minutes": "metadata.minutes.value",
        "icon": "metadata.icon.value",
        "href": "slug|route",
        "image": "featured_media_id|media"
      }
    },
    {
      "as": "topics",
      "collection": "topics",
      "kind": "topic",
      "record": "PostTopic",
      "fields": {
        "id": "id",
        "title": "title",
        "value": "metadata.value.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "posts",
      "title": {
        "$": "ui.content.posts.title"
      },
      "posts": {
        "$": "posts"
      },
      "labels": {
        "$": "ui.content.labels"
      },
      "filter": {
        "topics": {
          "$": "topics"
        },
        "label": {
          "$": "ui.vibe.posts.topics"
        },
        "topic": ""
      },
      "pager": {
        "label": {
          "$": "ui.content.posts.pager.label"
        },
        "summary": {
          "$": "ui.content.posts.pager.summary"
        },
        "previous": {
          "$": "ui.content.posts.pager.previous"
        },
        "next": {
          "$": "ui.content.posts.pager.next"
        },
        "pageLabel": {
          "$": "ui.content.posts.pager.page"
        }
      },
      "action": {
        "label": {
          "$": "ui.content.posts.action"
        },
        "href": "#/"
      }
    }
  }
}
