{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.menusimple",
  "name": "Simple menu",
  "docs": "The heading, one paragraph and the dishes (a picture, a badge when set, the name, the weight, a line, the price): on cards in three, two or four columns, or menu rows with the price at the end.",
  "theme": "marketing",
  "group": "food",
  "organism": "MenuSimple",
  "line": "simple",
  "model": "menu@1",
  "axes": {
    "layout": [
      "cards",
      "rows"
    ],
    "cols": [
      "3",
      "2",
      "4"
    ]
  },
  "defaults": {
    "layout": "cards",
    "cols": "3"
  },
  "variants": [
    {
      "id": "cards3",
      "set": {}
    },
    {
      "id": "cards2",
      "set": {
        "cols": "2"
      }
    },
    {
      "id": "cards4",
      "set": {
        "cols": "4"
      }
    },
    {
      "id": "rows",
      "set": {
        "layout": "rows"
      },
      "props": {
        "align": "start"
      }
    }
  ],
  "slots": [
    "MediaFrame"
  ],
  "facts": [
    {
      "sel": "section h2",
      "n": 1
    },
    {
      "sel": "ul > li",
      "n": "@menuDishes"
    },
    {
      "sel": "ul > li h3",
      "n": "@menuDishes"
    },
    {
      "sel": "[data-slot=\"media-frame\"]",
      "n": "@menuDishes"
    },
    {
      "sel": "[data-slot=\"badge\"]",
      "n": 2
    }
  ],
  "data": [
    {
      "as": "menuDishes",
      "collection": "simplemenu",
      "kind": "dish",
      "record": "MenuDish",
      "fields": {
        "id": "id",
        "image": "featured_media_id|media",
        "title": "title",
        "weight": "metadata.weight.value",
        "price": "metadata.display.value",
        "description": "metadata.summary.value",
        "badge": "metadata.badge.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "menusimple",
      "title": {
        "$": "ui.marketing.menuSimple.title"
      },
      "description": {
        "$": "ui.marketing.menuSimple.description"
      },
      "items": {
        "$": "menuDishes"
      }
    }
  }
}
