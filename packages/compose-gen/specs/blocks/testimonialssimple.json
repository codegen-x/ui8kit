{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.testimonialssimple",
  "name": "Simple testimonials",
  "docs": "The heading, one paragraph and the quotes as a list (the words, a portrait, the name and the role): on cards in two or three columns, in rows with the portrait at the side, or centred.",
  "theme": "marketing",
  "group": "proof",
  "organism": "TestimonialsSimple",
  "line": "simple",
  "model": "testimonials@1",
  "axes": {
    "layout": [
      "cards",
      "rows",
      "centered"
    ],
    "cols": [
      "2",
      "3"
    ]
  },
  "defaults": {
    "layout": "cards",
    "cols": "3"
  },
  "variants": [
    {
      "id": "cols3",
      "set": {}
    },
    {
      "id": "cards2",
      "set": {
        "cols": "2"
      }
    },
    {
      "id": "portraitRows",
      "set": {
        "layout": "rows"
      }
    },
    {
      "id": "centered",
      "set": {
        "layout": "centered"
      }
    }
  ],
  "slots": [
    "MediaFrame"
  ],
  "facts": [
    {
      "sel": "section h2",
      "n": 1
    },
    {
      "sel": "ul > li",
      "n": "@simpleQuotes"
    },
    {
      "sel": "ul > li h3",
      "n": "@simpleQuotes"
    },
    {
      "sel": "[data-slot=\"media-frame\"]",
      "n": "@simpleQuotes"
    }
  ],
  "data": [
    {
      "as": "simpleQuotes",
      "collection": "testimonials",
      "kind": "testimonial",
      "record": "SimpleQuote",
      "fields": {
        "id": "id",
        "quote": "metadata.quote.value",
        "avatar": "featured_media_id|media",
        "title": "title",
        "description": "metadata.role.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "testimonialssimple",
      "title": {
        "$": "ui.marketing.testimonialsSimple.title"
      },
      "description": {
        "$": "ui.marketing.testimonialsSimple.description"
      },
      "quotes": {
        "$": "simpleQuotes"
      }
    }
  }
}
