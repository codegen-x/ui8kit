{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.servicessimple",
  "name": "Simple services",
  "docs": "The heading, one paragraph and the services (the name as a link, a line, the starting price): on cards in three or two columns, or rows with the price at the end.",
  "theme": "marketing",
  "group": "features",
  "organism": "ServicesSimple",
  "line": "simple",
  "model": "services@1",
  "axes": {
    "layout": [
      "cards",
      "rows"
    ],
    "cols": [
      "3",
      "2"
    ]
  },
  "defaults": {
    "layout": "cards",
    "cols": "3"
  },
  "variants": [
    {
      "id": "cards3",
      "set": {}
    },
    {
      "id": "cards2",
      "set": {
        "cols": "2"
      }
    },
    {
      "id": "rows",
      "set": {
        "layout": "rows"
      },
      "props": {
        "align": "start"
      }
    }
  ],
  "slots": [],
  "facts": [
    {
      "sel": "section h2",
      "n": 1
    },
    {
      "sel": "ul > li",
      "n": "@serviceItems"
    },
    {
      "sel": "ul > li h3",
      "n": "@serviceItems"
    }
  ],
  "data": [
    {
      "as": "serviceItems",
      "collection": "simpleservices",
      "kind": "service",
      "record": "Service",
      "fields": {
        "id": "id",
        "title": "title",
        "description": "metadata.summary.value",
        "price": "metadata.display.value",
        "href": "slug|route"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "servicessimple",
      "title": {
        "$": "ui.marketing.servicesSimple.title"
      },
      "description": {
        "$": "ui.marketing.servicesSimple.description"
      },
      "items": {
        "$": "serviceItems"
      }
    }
  }
}
