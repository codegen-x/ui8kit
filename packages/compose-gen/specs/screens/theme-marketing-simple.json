{
  "$schema": "../../schema/schemas/composed.schema.json",
  "specVersion": 1,
  "id": "screen.theme-marketing-simple",
  "name": "ThemeMarketingSimpleScreen",
  "kind": "composed",
  "docs": "The simple line: blocks with one content model each (hero@1, split@1, team@1, intro@1, gallery@1, features@1, stats@1, stories@1, photos@1, testimonials@1, logos@1, faq@1, steps@1), the same content in every variant. A home page with the hero, the features, the team, the stats, the steps, the quotes and the questions, and a team page with the wide hero, the team on cards, the gallery, the photos and the stories.",
  "routes": [
    {
      "path": "",
      "area": "home"
    },
    {
      "path": "team",
      "area": "team"
    }
  ],
  "frame": {
    "before": [
      {
        "block": "navbar",
        "variant": "inline",
        "props": {
          "brandHref": "#/",
          "links": {
            "$": "nav.links"
          },
          "current": {
            "$": "nav.current"
          },
          "skip": {
            "$": "ui.site.header.skip"
          },
          "actions": {
            "themeLabel": {
              "$": "ui.theme.toggle"
            }
          }
        }
      }
    ],
    "after": [
      {
        "block": "sitemap",
        "variant": "columns"
      }
    ]
  },
  "areas": {
    "home": [
      {
        "block": "herosimple",
        "variant": "mediaEnd",
        "props": {
          "level": 1,
          "title": {
            "$": "ui.pages.marketingSimple.home.title"
          },
          "description": {
            "$": "ui.pages.marketingSimple.home.text"
          },
          "actionLabel": {
            "$": "ui.pages.marketingSimple.home.cta"
          },
          "actionHref": "#/team"
        }
      },
      {
        "block": "introsimple",
        "variant": "center"
      },
      {
        "block": "featuressimple",
        "variant": "cols3"
      },
      {
        "block": "teamsimple",
        "variant": "cols3"
      },
      {
        "block": "statssimple",
        "variant": "cols4"
      },
      {
        "block": "herosimple",
        "variant": "mediaStart"
      },
      {
        "block": "stepssimple",
        "variant": "row4"
      },
      {
        "block": "splitsimple",
        "variant": "mediaEnd"
      },
      {
        "block": "testimonialssimple",
        "variant": "cols3"
      },
      {
        "block": "logossimple",
        "variant": "row"
      },
      {
        "block": "faqsimple",
        "variant": "grid2"
      },
      {
        "block": "teamsimple",
        "variant": "cols2"
      },
      {
        "block": "herosimple",
        "variant": "mediaBottom"
      }
    ],
    "team": [
      {
        "block": "herosimple",
        "variant": "mediaTop",
        "props": {
          "level": 1,
          "title": {
            "$": "ui.pages.marketingSimple.team.title"
          },
          "description": {
            "$": "ui.pages.marketingSimple.team.text"
          },
          "actionLabel": {
            "$": "ui.pages.marketingSimple.team.cta"
          },
          "actionHref": "#/"
        }
      },
      {
        "block": "teamsimple",
        "variant": "cards3"
      },
      {
        "block": "galleryhero",
        "variant": "photos3"
      },
      {
        "block": "splitsimple",
        "variant": "mediaStart"
      },
      {
        "block": "photossimple",
        "variant": "row4"
      },
      {
        "block": "storiessimple",
        "variant": "cols3"
      },
      {
        "block": "teamsimple",
        "variant": "cols4"
      }
    ]
  },
  "chunks": true,
  "requireH1": true,
  "nameLandmarks": true,
  "nav": true,
  "menu": [
    {
      "id": "home",
      "path": "",
      "titleKey": "pages.marketingSimple.home.nav"
    },
    {
      "id": "team",
      "path": "team",
      "titleKey": "pages.marketingSimple.team.nav"
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true
  }
}
