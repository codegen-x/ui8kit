{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.cta-simple",
  "name": "CtaSimple",
  "docs": "The simple call to action (model cta@1): one band with an optional badge, the heading, a description and up to two links styled as buttons (the first primary, the second secondary; each drawn when its label and its address are both set). Text only (a picture beside the copy is the split or the hero). Axes: layout (stack: the copy and the actions in one column, placed by the align setting; between: the copy at the start, the actions at the end from md up), surface (muted: a muted band, outline: a bordered card).",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "badge",
      "type": "string",
      "default": "",
      "docs": "a short pill above the heading; empty: no badge"
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "description",
      "type": "string",
      "default": "",
      "docs": "one paragraph under the heading; empty: none"
    },
    {
      "name": "actionLabel",
      "type": "string",
      "default": "",
      "docs": "the label of the action; the link is drawn when the label and the address are both set"
    },
    {
      "name": "actionHref",
      "type": "string",
      "default": "",
      "docs": "the address of the action"
    },
    {
      "name": "secondaryActionLabel",
      "type": "string",
      "default": "",
      "docs": "the label of the second action (the secondary button after the first); drawn when the label and the address are both set"
    },
    {
      "name": "secondaryActionHref",
      "type": "string",
      "default": "",
      "docs": "the address of the second action"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\" | \"end\""
      },
      "default": "center",
      "docs": "the alignment of the copy: start, center or end (logical, follows the writing direction): items-* on the column, text-* on the text"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"stack\" | \"between\""
      },
      "default": "stack"
    },
    {
      "name": "surface",
      "type": {
        "ts": "\"muted\" | \"outline\""
      },
      "default": "muted"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "column",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "end",
              "start"
            ]
          }
        ]
      }
    },
    {
      "name": "textAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "text-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "text-end",
              "text-start"
            ]
          }
        ]
      }
    },
    {
      "name": "itemsAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "items-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "items-end",
              "items-start"
            ]
          }
        ]
      }
    },
    {
      "name": "selfAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "self-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "self-end",
              ""
            ]
          }
        ]
      }
    },
    {
      "name": "frame",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "between"
            ]
          },
          "flex flex-col gap-8 md:flex-row md:items-center md:justify-between",
          "flex flex-col gap-6"
        ]
      }
    },
    {
      "name": "band",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "surface"
              },
              "outline"
            ]
          },
          "rounded border border-border bg-card p-8 text-card-foreground md:p-12",
          "rounded bg-muted p-8 md:p-12"
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "cta-simple"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    {
                      "$": "band"
                    },
                    {
                      "$": "frame"
                    }
                  ]
                }
              },
              "children": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": {
                      "$": "column"
                    }
                  },
                  "children": [
                    {
                      "when": {
                        "$": "badge"
                      },
                      "then": [
                        {
                          "use": "Badge",
                          "props": {
                            "Variant": "secondary"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "badge"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "Title",
                      "props": {
                        "As": {
                          "$": "level"
                        },
                        "Size": "3xl",
                        "Weight": "bold",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "max-w-2xl tracking-tight",
                            {
                              "$": "textAlign"
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "id": {
                          "$": "titleId"
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "description"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "lg",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "text-muted-foreground",
                                {
                                  "$": "textAlign"
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "description"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "or",
                    "args": [
                      {
                        "op": "and",
                        "args": [
                          {
                            "$": "actionLabel"
                          },
                          {
                            "$": "actionHref"
                          }
                        ]
                      },
                      {
                        "op": "and",
                        "args": [
                          {
                            "$": "secondaryActionLabel"
                          },
                          {
                            "$": "secondaryActionHref"
                          }
                        ]
                      }
                    ]
                  },
                  "then": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "4",
                        "Align": "center",
                        "Justify": {
                          "$": "column"
                        },
                        "Class": "flex-wrap"
                      },
                      "children": [
                        {
                          "when": {
                            "op": "and",
                            "args": [
                              {
                                "$": "actionLabel"
                              },
                              {
                                "$": "actionHref"
                              }
                            ]
                          },
                          "then": [
                            {
                              "use": "LinkButton",
                              "props": {
                                "Variant": "default",
                                "Size": "lg",
                                "Href": {
                                  "$": "actionHref"
                                }
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "actionLabel"
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "when": {
                            "op": "and",
                            "args": [
                              {
                                "$": "secondaryActionLabel"
                              },
                              {
                                "$": "secondaryActionHref"
                              }
                            ]
                          },
                          "then": [
                            {
                              "use": "LinkButton",
                              "props": {
                                "Variant": "secondary",
                                "Size": "lg",
                                "Href": {
                                  "$": "secondaryActionHref"
                                }
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "secondaryActionLabel"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
