{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.recipe-kits",
  "name": "RecipeKits",
  "docs": "Recipe kits delivered home: a picture beside the kit name, cooking time, the ingredients list, a portions radio group and the price with an add button. Axes: layout (rows, cards), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "portions",
      "type": {
        "ts": "DishOption[]"
      },
      "required": true,
      "docs": "the portion sizes, the first checked"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"rows\" | \"cards\""
      },
      "default": "rows"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "dishes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "package",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "cards"
                          ]
                        },
                        "grid grid-cols-1 gap-8 md:grid-cols-3",
                        "flex flex-col gap-8"
                      ]
                    }
                  },
                  "attrs": {
                    "data-slot": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "dishes"
                      },
                      "as": "d",
                      "key": {
                        "$": "d.id"
                      },
                      "do": [
                        {
                          "use": "Box",
                          "props": {
                            "Class": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "layout"
                                    },
                                    "cards"
                                  ]
                                },
                                "rounded bg-card inset-ring inset-ring-border flex flex-col gap-4 p-4",
                                "rounded bg-card inset-ring inset-ring-border grid grid-cols-1 gap-8 p-6 md:grid-cols-2"
                              ]
                            }
                          },
                          "attrs": {
                            "data-slot": "item"
                          },
                          "children": [
                            {
                              "organism": "MediaFrame",
                              "props": {
                                "alt": {
                                  "$": "d.name"
                                },
                                "ratio": "4/3"
                              }
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "4"
                              },
                              "children": [
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "2",
                                    "Class": "flex-wrap"
                                  },
                                  "children": [
                                    {
                                      "use": "Badge",
                                      "props": {
                                        "Variant": "secondary",
                                        "Size": "default"
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "timer",
                                            "Size": 16
                                          }
                                        },
                                        {
                                          "text": {
                                            "op": "tpl",
                                            "args": [
                                              {
                                                "$": "labels.minutes"
                                              },
                                              {
                                                "op": "str",
                                                "args": [
                                                  {
                                                    "$": "d.minutes"
                                                  }
                                                ]
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "when": {
                                        "$": "d.badge"
                                      },
                                      "then": [
                                        {
                                          "use": "Badge",
                                          "props": {
                                            "Variant": "outline",
                                            "Size": "default"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "d.badge"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2"
                                  },
                                  "children": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "xl",
                                        "Weight": "semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "d.name"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "d.summary"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2"
                                  },
                                  "children": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Weight": "semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "labels.ingredients"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "List",
                                      "props": {
                                        "Tag": "ul",
                                        "Class": "grid grid-cols-1 gap-2 text-sm sm:grid-cols-2"
                                      },
                                      "attrs": {
                                        "data-slot": "ingredients"
                                      },
                                      "children": [
                                        {
                                          "each": {
                                            "$": "d.items"
                                          },
                                          "as": "x",
                                          "key": {
                                            "$": "x"
                                          },
                                          "do": [
                                            {
                                              "use": "ListItem",
                                              "props": {
                                                "Class": "flex items-center gap-2"
                                              },
                                              "children": [
                                                {
                                                  "use": "LucideIcon",
                                                  "props": {
                                                    "Name": "check",
                                                    "Size": 16,
                                                    "Class": "text-primary"
                                                  }
                                                },
                                                {
                                                  "use": "Inline",
                                                  "children": [
                                                    {
                                                      "text": {
                                                        "$": "x"
                                                      }
                                                    }
                                                  ]
                                                }
                                              ],
                                              "attrs": {
                                                "data-slot": "items-row"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "organism": "OptionChips",
                                  "props": {
                                    "name": {
                                      "op": "tpl",
                                      "args": [
                                        "{0}-portions-{1}",
                                        {
                                          "$": "id"
                                        },
                                        {
                                          "$": "d.id"
                                        }
                                      ]
                                    },
                                    "legend": {
                                      "$": "labels.portions"
                                    },
                                    "options": {
                                      "$": "portions"
                                    }
                                  }
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "center",
                                    "Justify": "between",
                                    "Class": "mt-auto"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-xl font-bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "money",
                                            "args": [
                                              {
                                                "$": "d.price"
                                              },
                                              {
                                                "$": "d.currency"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Button",
                                      "props": {
                                        "Variant": "default",
                                        "Size": "default",
                                        "Type": "button",
                                        "AriaLabel": {
                                          "op": "tpl",
                                          "args": [
                                            {
                                              "$": "labels.addOf"
                                            },
                                            {
                                              "$": "d.name"
                                            }
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "labels.add"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    },
    {
      "from": "OptionChips",
      "names": [
        "DishOption"
      ]
    }
  ]
}
