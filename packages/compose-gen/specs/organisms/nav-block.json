{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.nav-block",
  "name": "NavBlock",
  "docs": "A navigation region in its own file: Block tag nav named by `label`.",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "docs": "accessible name of the navigation"
    },
    {
      "name": "testid",
      "type": "string",
      "docs": "data-slot of the root (default: the component name)"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "className": true,
  "children": true,
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "nav",
        "Class": {
          "op": "cn",
          "args": [
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "aria-label": {
          "op": "coalesce",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "$": "label"
            }
          ]
        },
        "data-slot": {
          "op": "coalesce",
          "args": [
            {
              "$": "testid"
            },
            "nav-block"
          ]
        }
      },
      "children": [
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
