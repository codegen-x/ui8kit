{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.course-outline",
  "name": "CourseOutline",
  "docs": "The course outline (model curriculum@1): the heading, a description and the modules as an ordered list, each with a short label (a badge), the title, a line and a meta line (the length). Axes: layout (rows: one under the other in a narrow column, cards: two columns on a card surface from md up).",
  "records": {
    "CourseModule": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "label",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "description",
        "type": "string",
        "optional": true
      },
      {
        "name": "meta",
        "type": "string",
        "optional": true
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "description",
      "type": "string",
      "default": "",
      "docs": "one paragraph under the heading; empty: none"
    },
    {
      "name": "modules",
      "type": {
        "ts": "CourseModule[]"
      },
      "required": true,
      "docs": "the modules, in the order they are taken (1 to 12)"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\" | \"end\""
      },
      "default": "start",
      "docs": "the alignment of the copy: start, center or end (logical, follows the writing direction): items-* on the column, text-* on the text"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"rows\" | \"cards\""
      },
      "default": "rows"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "column",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "end",
              "start"
            ]
          }
        ]
      }
    },
    {
      "name": "textAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "text-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "text-end",
              "text-start"
            ]
          }
        ]
      }
    },
    {
      "name": "itemsAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "items-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "items-end",
              "items-start"
            ]
          }
        ]
      }
    },
    {
      "name": "selfAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "self-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "self-end",
              ""
            ]
          }
        ]
      }
    },
    {
      "name": "narrow",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "rows"
            ]
          },
          "mx-auto w-full max-w-3xl",
          ""
        ]
      }
    },
    {
      "name": "grid",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "cards"
            ]
          },
          "gap-6 md:grid-cols-2",
          "gap-8"
        ]
      }
    },
    {
      "name": "item",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "cards"
            ]
          },
          "rounded bg-card p-6 text-card-foreground border border-border flex flex-col items-start gap-4",
          "flex flex-col items-start gap-4 sm:flex-row"
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "course-outline"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Stack",
              "props": {
                "Gap": "12",
                "Align": "stretch",
                "Class": {
                  "$": "narrow"
                }
              },
              "children": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": {
                      "$": "column"
                    },
                    "Class": {
                      "op": "cn",
                      "args": [
                        "max-w-2xl",
                        {
                          "$": "selfAlign"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "use": "Title",
                      "props": {
                        "As": {
                          "$": "level"
                        },
                        "Size": "3xl",
                        "Weight": "bold",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "tracking-tight",
                            {
                              "$": "textAlign"
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "id": {
                          "$": "titleId"
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "description"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "base",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "text-muted-foreground",
                                {
                                  "$": "textAlign"
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "description"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "List",
                  "props": {
                    "Tag": "ol",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "m-0 grid w-full list-none grid-cols-1 p-0",
                        {
                          "$": "grid"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "each": {
                        "$": "modules"
                      },
                      "as": "m",
                      "key": {
                        "$": "m.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": {
                              "$": "item"
                            }
                          },
                          "attrs": {
                            "data-slot": "module"
                          },
                          "children": [
                            {
                              "use": "Badge",
                              "props": {
                                "Variant": "secondary"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "m.label"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2",
                                "Align": "start",
                                "Class": "grow"
                              },
                              "children": [
                                {
                                  "use": "Title",
                                  "props": {
                                    "As": {
                                      "op": "add",
                                      "args": [
                                        {
                                          "$": "level"
                                        },
                                        1
                                      ]
                                    },
                                    "Size": "lg",
                                    "Weight": "semibold",
                                    "Class": "text-start"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "m.title"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "when": {
                                    "$": "m.description"
                                  },
                                  "then": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Class": {
                                          "op": "cn",
                                          "args": [
                                            "text-muted-foreground",
                                            "text-start"
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "m.description"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "when": {
                                "$": "m.meta"
                              },
                              "then": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Class": {
                                      "op": "cn",
                                      "args": [
                                        "text-muted-foreground",
                                        "text-start whitespace-nowrap"
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "m.meta"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
