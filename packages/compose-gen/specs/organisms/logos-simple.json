{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.logos-simple",
  "name": "LogosSimple",
  "docs": "The simple logos (model logos@1): a short heading and the logos as a list, each a picture named by the company. Axes: surface (plain: a wrapping row, cards: a grid on a card surface).",
  "records": {
    "SimpleLogo": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "image",
        "type": "string",
        "optional": true
      },
      {
        "name": "title",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "logos",
      "type": {
        "ts": "SimpleLogo[]"
      },
      "required": true,
      "docs": "the logos, in the order they are shown (1 to 8)"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\" | \"end\""
      },
      "default": "center",
      "docs": "the alignment of the copy: start, center or end (logical, follows the writing direction): items-* on the column, text-* on the text"
    },
    {
      "name": "surface",
      "type": {
        "ts": "\"plain\" | \"cards\""
      },
      "default": "plain"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "column",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "end",
              "start"
            ]
          }
        ]
      }
    },
    {
      "name": "textAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "text-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "text-end",
              "text-start"
            ]
          }
        ]
      }
    },
    {
      "name": "itemsAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "items-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "items-end",
              "items-start"
            ]
          }
        ]
      }
    },
    {
      "name": "selfAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "self-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "self-end",
              ""
            ]
          }
        ]
      }
    },
    {
      "name": "row",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "surface"
              },
              "cards"
            ]
          },
          "grid grid-cols-2 gap-4 md:grid-cols-4",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "center"
                ]
              },
              "flex flex-wrap justify-center gap-8",
              {
                "op": "cond",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "align"
                      },
                      "end"
                    ]
                  },
                  "flex flex-wrap justify-end gap-8",
                  "flex flex-wrap justify-start gap-8"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "item",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "surface"
              },
              "cards"
            ]
          },
          "flex rounded bg-card p-6 border border-border",
          "w-32"
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "logos-simple"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Stack",
              "props": {
                "Gap": "8",
                "Align": {
                  "$": "column"
                }
              },
              "children": [
                {
                  "use": "Title",
                  "props": {
                    "As": {
                      "$": "level"
                    },
                    "Size": "lg",
                    "Weight": "semibold",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "text-muted-foreground",
                        {
                          "$": "textAlign"
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "id": {
                      "$": "titleId"
                    }
                  },
                  "children": [
                    {
                      "text": {
                        "$": "title"
                      }
                    }
                  ]
                },
                {
                  "use": "List",
                  "props": {
                    "Tag": "ul",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "m-0 list-none p-0",
                        {
                          "op": "cn",
                          "args": [
                            "w-full",
                            {
                              "$": "row"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "each": {
                        "$": "logos"
                      },
                      "as": "l",
                      "key": {
                        "$": "l.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": {
                              "$": "item"
                            }
                          },
                          "attrs": {
                            "data-slot": "logo"
                          },
                          "children": [
                            {
                              "organism": "MediaFrame",
                              "props": {
                                "alt": {
                                  "$": "l.title"
                                },
                                "src": {
                                  "$": "l.image"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
