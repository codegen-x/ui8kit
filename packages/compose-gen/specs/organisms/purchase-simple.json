{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.purchase-simple",
  "name": "PurchaseSimple",
  "docs": "The simple purchase (model purchase@1): on a card surface, the heading and a description beside the price, one action and a note. Axes: layout (panel: the copy at the start, the price and the action at the end from md up, centered: one centred column).",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "description",
      "type": "string",
      "default": "",
      "docs": "one paragraph under the heading; empty: none"
    },
    {
      "name": "price",
      "type": "string",
      "required": true,
      "docs": "the price as it is shown"
    },
    {
      "name": "note",
      "type": "string",
      "default": "",
      "docs": "a short note under the action; empty: none"
    },
    {
      "name": "actionLabel",
      "type": "string",
      "default": "",
      "docs": "the label of the action; the link is drawn when the label and the address are both set"
    },
    {
      "name": "actionHref",
      "type": "string",
      "default": "",
      "docs": "the address of the action"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"panel\" | \"centered\""
      },
      "default": "panel"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "box",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "panel"
            ]
          },
          "md:flex-row md:items-center md:justify-between md:gap-12",
          "items-center"
        ]
      }
    },
    {
      "name": "copyAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "panel"
            ]
          },
          "start",
          "center"
        ]
      }
    },
    {
      "name": "copyText",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "panel"
            ]
          },
          "text-start",
          "text-center"
        ]
      }
    },
    {
      "name": "buy",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "panel"
            ]
          },
          "md:items-end",
          ""
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "purchase-simple"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "rounded bg-card p-6 text-card-foreground border border-border",
                    "flex flex-col gap-8",
                    {
                      "$": "box"
                    }
                  ]
                }
              },
              "children": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": {
                      "$": "copyAlign"
                    },
                    "Class": "max-w-2xl"
                  },
                  "children": [
                    {
                      "use": "Title",
                      "props": {
                        "As": {
                          "$": "level"
                        },
                        "Size": "2xl",
                        "Weight": "bold",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "tracking-tight",
                            {
                              "$": "copyText"
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "id": {
                          "$": "titleId"
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "description"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "base",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "text-muted-foreground",
                                {
                                  "$": "copyText"
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "description"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": {
                      "$": "copyAlign"
                    },
                    "Class": {
                      "op": "cn",
                      "args": [
                        "shrink-0",
                        {
                          "$": "buy"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "3xl",
                        "Weight": "bold",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "tracking-tight",
                            {
                              "$": "copyText"
                            }
                          ]
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "price"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "and",
                        "args": [
                          {
                            "$": "actionLabel"
                          },
                          {
                            "$": "actionHref"
                          }
                        ]
                      },
                      "then": [
                        {
                          "use": "LinkButton",
                          "props": {
                            "Variant": "default",
                            "Size": "lg",
                            "Href": {
                              "$": "actionHref"
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "actionLabel"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "note"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "text-muted-foreground",
                                {
                                  "$": "copyText"
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "note"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
