{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.veggie-box",
  "name": "VeggieBox",
  "docs": "A vegetable box by weight: produce tiles (picture, name, price per kg, a weight field in kg named after the item) beside the box card with a meter of how full the box is, the total and the order button. Axes: layout (split, stacked), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "fill",
      "type": "number",
      "default": 60,
      "docs": "how full the box is, percent"
    },
    {
      "name": "total",
      "type": "number",
      "required": true,
      "docs": "minor units"
    },
    {
      "name": "currency",
      "type": "string",
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"split\" | \"stacked\""
      },
      "default": "split"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "dishes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "package",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": "grid grid-cols-1 items-start gap-8 lg:grid-cols-3"
                  },
                  "children": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "split"
                              ]
                            },
                            "grid grid-cols-2 gap-4 md:grid-cols-3 lg:col-span-2",
                            "grid grid-cols-2 gap-4 md:grid-cols-3 lg:col-span-3 lg:grid-cols-6"
                          ]
                        }
                      },
                      "attrs": {
                        "data-slot": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "dishes"
                          },
                          "as": "d",
                          "key": {
                            "$": "d.id"
                          },
                          "do": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2",
                                "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                              },
                              "attrs": {
                                "data-slot": "item"
                              },
                              "children": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "d.name"
                                    },
                                    "ratio": "1/1"
                                  }
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.name"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "xs",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "op": "tpl",
                                        "args": [
                                          {
                                            "$": "labels.perKg"
                                          },
                                          {
                                            "op": "money",
                                            "args": [
                                              {
                                                "$": "d.price"
                                              },
                                              {
                                                "$": "d.currency"
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                },
                                {
                                  "organism": "NumberField",
                                  "props": {
                                    "value": "1",
                                    "name": {
                                      "op": "tpl",
                                      "args": [
                                        "{0}-kg-{1}",
                                        {
                                          "$": "id"
                                        },
                                        {
                                          "$": "d.id"
                                        }
                                      ]
                                    },
                                    "min": "0",
                                    "label": {
                                      "op": "tpl",
                                      "args": [
                                        {
                                          "$": "labels.weightOf"
                                        },
                                        {
                                          "$": "d.name"
                                        }
                                      ]
                                    },
                                    "decrease": {
                                      "op": "tpl",
                                      "args": [
                                        {
                                          "$": "labels.decreaseOf"
                                        },
                                        {
                                          "$": "d.name"
                                        }
                                      ]
                                    },
                                    "increase": {
                                      "op": "tpl",
                                      "args": [
                                        {
                                          "$": "labels.increaseOf"
                                        },
                                        {
                                          "$": "d.name"
                                        }
                                      ]
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "split"
                              ]
                            },
                            "rounded bg-card inset-ring inset-ring-border p-6 lg:sticky lg:top-8",
                            "rounded bg-card inset-ring inset-ring-border p-6 lg:col-span-3"
                          ]
                        }
                      },
                      "attrs": {
                        "data-slot": "summary"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "lg",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "labels.summary"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Label",
                          "props": {
                            "For": {
                              "op": "tpl",
                              "args": [
                                "{0}-fill",
                                {
                                  "$": "id"
                                }
                              ]
                            },
                            "Class": "text-sm text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "labels.boxFill"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Meter",
                          "props": {
                            "Value": {
                              "$": "fill"
                            },
                            "Min": 0,
                            "Max": 100
                          },
                          "attrs": {
                            "id": {
                              "op": "tpl",
                              "args": [
                                "{0}-fill",
                                {
                                  "$": "id"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "2",
                            "Align": "baseline",
                            "Justify": "between"
                          },
                          "children": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "labels.total"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Inline",
                              "props": {
                                "Class": "text-2xl font-bold"
                              },
                              "attrs": {
                                "role": "status",
                                "aria-live": "polite",
                                "data-slot": "total"
                              },
                              "children": [
                                {
                                  "text": {
                                    "op": "money",
                                    "args": [
                                      {
                                        "$": "total"
                                      },
                                      {
                                        "$": "currency"
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "Button",
                          "props": {
                            "Variant": "default",
                            "Size": "lg",
                            "Type": "button",
                            "Class": "w-full"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": "shopping-bag",
                                "Size": 16
                              }
                            },
                            {
                              "text": {
                                "$": "labels.order"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    }
  ]
}
