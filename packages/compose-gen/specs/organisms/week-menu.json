{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.week-menu",
  "name": "WeekMenu",
  "docs": "Meal delivery as a week: one column per day (its name and delivery note) with the meal of that day as a small card (picture, name, weight, price). Axes: media (image, none), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "sections",
      "type": {
        "ts": "DishSection[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "media",
      "type": {
        "ts": "\"image\" | \"none\""
      },
      "default": "image"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "sections"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "calendar",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5"
                  },
                  "attrs": {
                    "data-slot": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "sections"
                      },
                      "as": "s",
                      "key": {
                        "$": "s.id"
                      },
                      "do": [
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "2",
                            "Class": "border-t-2 border-primary pt-4"
                          },
                          "attrs": {
                            "data-slot": "day"
                          },
                          "children": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Weight": "semibold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "s.title"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "s.note"
                                  }
                                }
                              ]
                            },
                            {
                              "each": {
                                "$": "dishes"
                              },
                              "as": "d",
                              "key": {
                                "$": "d.id"
                              },
                              "do": [
                                {
                                  "when": {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "d.tag"
                                      },
                                      {
                                        "$": "s.key"
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "2",
                                        "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                                      },
                                      "attrs": {
                                        "data-slot": "item"
                                      },
                                      "children": [
                                        {
                                          "when": {
                                            "op": "eq",
                                            "args": [
                                              {
                                                "$": "media"
                                              },
                                              "image"
                                            ]
                                          },
                                          "then": [
                                            {
                                              "organism": "MediaFrame",
                                              "props": {
                                                "alt": {
                                                  "$": "d.name"
                                                },
                                                "ratio": "4/3"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Weight": "semibold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "d.name"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Group",
                                          "props": {
                                            "Gap": "2",
                                            "Align": "baseline",
                                            "Justify": "between"
                                          },
                                          "children": [
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "xs",
                                                "Class": "text-muted-foreground"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "d.weight"
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "use": "Inline",
                                              "props": {
                                                "Class": "text-sm font-bold"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "op": "money",
                                                    "args": [
                                                      {
                                                        "$": "d.price"
                                                      },
                                                      {
                                                        "$": "d.currency"
                                                      }
                                                    ]
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    },
    {
      "from": "RestaurantMenu",
      "names": [
        "DishSection"
      ]
    }
  ]
}
