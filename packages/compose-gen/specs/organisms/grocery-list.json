{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.grocery-list",
  "name": "GroceryList",
  "docs": "Groceries as a compact list: a small square picture (or none), the name, the pack size, the price and an add button, in one or two columns. Axes: thumbs (show, hide), cols (1, 2), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "thumbs",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1\" | \"2\""
      },
      "default": "2"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "dishes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "shopping-bag",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "List",
                  "props": {
                    "Tag": "ul",
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "cols"
                            },
                            "2"
                          ]
                        },
                        "grid grid-cols-1 gap-x-8 md:grid-cols-2",
                        "grid grid-cols-1"
                      ]
                    }
                  },
                  "attrs": {
                    "data-slot": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "dishes"
                      },
                      "as": "d",
                      "key": {
                        "$": "d.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": "flex items-center gap-4 border-b border-border py-2"
                          },
                          "attrs": {
                            "data-slot": "item"
                          },
                          "children": [
                            {
                              "when": {
                                "op": "eq",
                                "args": [
                                  {
                                    "$": "thumbs"
                                  },
                                  "show"
                                ]
                              },
                              "then": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "d.name"
                                    },
                                    "ratio": "1/1",
                                    "className": "size-12 shrink-0"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "0",
                                "Class": "min-w-0 flex-1"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.name"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "xs",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "op": "tpl",
                                        "args": [
                                          "{0} · {1}",
                                          {
                                            "$": "d.weight"
                                          },
                                          {
                                            "$": "d.tag"
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "Inline",
                              "props": {
                                "Class": "text-sm font-bold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "op": "money",
                                    "args": [
                                      {
                                        "$": "d.price"
                                      },
                                      {
                                        "$": "d.currency"
                                      }
                                    ]
                                  }
                                }
                              ]
                            },
                            {
                              "organism": "AddIcon",
                              "props": {
                                "label": {
                                  "op": "tpl",
                                  "args": [
                                    {
                                      "$": "labels.addOf"
                                    },
                                    {
                                      "$": "d.name"
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    }
  ]
}
