{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.dish-strip",
  "name": "DishStrip",
  "docs": "A horizontal strip of dishes that scrolls sideways (a focusable, named region with snap points): small cards with a picture, name, weight, price and an add button. Axes: size (sm, lg), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "size",
      "type": {
        "ts": "\"sm\" | \"lg\""
      },
      "default": "sm"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "dishes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "star",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "List",
                  "props": {
                    "Tag": "ul",
                    "Class": "-mx-4 flex snap-x gap-4 overflow-x-auto px-4 pb-4"
                  },
                  "attrs": {
                    "tabindex": 0,
                    "aria-label": {
                      "$": "labels.strip"
                    },
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "dishes"
                      },
                      "as": "d",
                      "key": {
                        "$": "d.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "size"
                                    },
                                    "lg"
                                  ]
                                },
                                "flex w-64 shrink-0 snap-start flex-col gap-2",
                                "flex w-48 shrink-0 snap-start flex-col gap-2"
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "item"
                          },
                          "children": [
                            {
                              "organism": "MediaFrame",
                              "props": {
                                "alt": {
                                  "$": "d.name"
                                },
                                "ratio": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "size"
                                        },
                                        "lg"
                                      ]
                                    },
                                    "4/3",
                                    "1/1"
                                  ]
                                }
                              }
                            },
                            {
                              "use": "Group",
                              "props": {
                                "Gap": "2",
                                "Align": "baseline",
                                "Justify": "between"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.name"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "xs",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.weight"
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "Group",
                              "props": {
                                "Gap": "2",
                                "Align": "center",
                                "Justify": "between"
                              },
                              "children": [
                                {
                                  "use": "Inline",
                                  "props": {
                                    "Class": "text-sm font-bold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "op": "money",
                                        "args": [
                                          {
                                            "$": "d.price"
                                          },
                                          {
                                            "$": "d.currency"
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                },
                                {
                                  "organism": "AddIcon",
                                  "props": {
                                    "label": {
                                      "op": "tpl",
                                      "args": [
                                        {
                                          "$": "labels.addOf"
                                        },
                                        {
                                          "$": "d.name"
                                        }
                                      ]
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    }
  ]
}
