{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.grill-builder",
  "name": "GrillBuilder",
  "docs": "A grill (mangal) dish builder: the meat as picture cards in a radio group, the weight as chips, the sides as checkboxes with prices, then a summary with the live total and the order button. Axes: layout (split, stacked), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "meats",
      "type": {
        "ts": "DishOption[]"
      },
      "required": true,
      "docs": "the meats, price per 500 g"
    },
    {
      "name": "weights",
      "type": {
        "ts": "DishOption[]"
      },
      "required": true,
      "docs": "the weights"
    },
    {
      "name": "sides",
      "type": {
        "ts": "DishOption[]"
      },
      "required": true,
      "docs": "the sides (checkboxes)"
    },
    {
      "name": "total",
      "type": "number",
      "required": true,
      "docs": "the total of the first choices, minor units"
    },
    {
      "name": "currency",
      "type": "string",
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"split\" | \"stacked\""
      },
      "default": "split"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Box",
              "props": {
                "Class": "grid grid-cols-1 items-start gap-8 lg:grid-cols-3"
              },
              "children": [
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "split"
                          ]
                        },
                        "flex flex-col gap-8 lg:col-span-2",
                        "flex flex-col gap-8 lg:col-span-3"
                      ]
                    }
                  },
                  "attrs": {
                    "data-slot": "steps"
                  },
                  "children": [
                    {
                      "organism": "MeatCards",
                      "props": {
                        "name": {
                          "op": "tpl",
                          "args": [
                            "{0}-meat",
                            {
                              "$": "id"
                            }
                          ]
                        },
                        "legend": {
                          "$": "labels.meat"
                        },
                        "options": {
                          "$": "meats"
                        }
                      }
                    },
                    {
                      "organism": "OptionChips",
                      "props": {
                        "name": {
                          "op": "tpl",
                          "args": [
                            "{0}-weight",
                            {
                              "$": "id"
                            }
                          ]
                        },
                        "legend": {
                          "$": "labels.weight"
                        },
                        "options": {
                          "$": "weights"
                        },
                        "extra": "note"
                      }
                    },
                    {
                      "organism": "SideChecks",
                      "props": {
                        "name": {
                          "op": "tpl",
                          "args": [
                            "{0}-sides",
                            {
                              "$": "id"
                            }
                          ]
                        },
                        "legend": {
                          "$": "labels.sides"
                        },
                        "options": {
                          "$": "sides"
                        }
                      }
                    }
                  ]
                },
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "split"
                          ]
                        },
                        "rounded bg-card inset-ring inset-ring-border flex flex-col gap-4 p-6 lg:sticky lg:top-8",
                        "rounded bg-card inset-ring inset-ring-border flex flex-col gap-4 p-6"
                      ]
                    }
                  },
                  "attrs": {
                    "data-slot": "summary"
                  },
                  "children": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "lg",
                        "Weight": "semibold"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.summary"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "2",
                        "Align": "baseline",
                        "Justify": "between"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "labels.total"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Inline",
                          "props": {
                            "Class": "text-2xl font-bold"
                          },
                          "attrs": {
                            "role": "status",
                            "aria-live": "polite",
                            "data-slot": "total"
                          },
                          "children": [
                            {
                              "text": {
                                "op": "money",
                                "args": [
                                  {
                                    "$": "total"
                                  },
                                  {
                                    "$": "currency"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "Button",
                      "props": {
                        "Variant": "default",
                        "Size": "lg",
                        "Type": "button",
                        "Class": "w-full"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": "shopping-bag",
                            "Size": 16
                          }
                        },
                        {
                          "text": {
                            "$": "labels.add"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    },
    {
      "from": "OptionChips",
      "names": [
        "DishOption"
      ]
    }
  ]
}
