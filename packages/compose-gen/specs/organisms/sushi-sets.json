{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.sushi-sets",
  "name": "SushiSets",
  "docs": "Sushi sets as a dense grid of tiles: a square picture with the piece count over it, the name, the rolls of the set as a list, the price and an add button. Axes: cols (3, 4), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"3\" | \"4\""
      },
      "default": "4"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "dishes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "package",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "cols"
                            },
                            "3"
                          ]
                        },
                        "1-3",
                        "1-4"
                      ]
                    },
                    "Class": "gap-4"
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "dishes"
                      },
                      "as": "d",
                      "key": {
                        "$": "d.id"
                      },
                      "do": [
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "4",
                            "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                          },
                          "attrs": {
                            "data-testid": "item"
                          },
                          "children": [
                            {
                              "use": "Box",
                              "props": {
                                "Class": "relative"
                              },
                              "children": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "d.name"
                                    },
                                    "ratio": "1/1"
                                  }
                                },
                                {
                                  "use": "Badge",
                                  "props": {
                                    "Variant": "default",
                                    "Size": "default",
                                    "Class": "absolute left-2 top-2"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.weight"
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "base",
                                "Weight": "semibold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "d.name"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "List",
                              "props": {
                                "Tag": "ul",
                                "Class": "flex flex-col gap-2 text-sm text-muted-foreground"
                              },
                              "attrs": {
                                "aria-label": {
                                  "op": "tpl",
                                  "args": [
                                    {
                                      "$": "labels.pieces"
                                    },
                                    {
                                      "$": "d.name"
                                    }
                                  ]
                                }
                              },
                              "children": [
                                {
                                  "each": {
                                    "$": "d.items"
                                  },
                                  "as": "r",
                                  "key": {
                                    "$": "r"
                                  },
                                  "do": [
                                    {
                                      "use": "ListItem",
                                      "props": {
                                        "Class": "flex items-center gap-2"
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "check",
                                            "Size": 16
                                          }
                                        },
                                        {
                                          "use": "Inline",
                                          "children": [
                                            {
                                              "text": {
                                                "$": "r"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "Group",
                              "props": {
                                "Gap": "2",
                                "Align": "center",
                                "Justify": "between",
                                "Class": "mt-auto"
                              },
                              "children": [
                                {
                                  "use": "Inline",
                                  "props": {
                                    "Class": "text-lg font-bold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "op": "money",
                                        "args": [
                                          {
                                            "$": "d.price"
                                          },
                                          {
                                            "$": "d.currency"
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                },
                                {
                                  "organism": "AddIcon",
                                  "props": {
                                    "label": {
                                      "op": "tpl",
                                      "args": [
                                        {
                                          "$": "labels.addOf"
                                        },
                                        {
                                          "$": "d.name"
                                        }
                                      ]
                                    },
                                    "variant": "default"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    }
  ]
}
