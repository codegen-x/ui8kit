{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.dish-cart-grid",
  "name": "DishCartGrid",
  "docs": "Dishes added to the cart from the card: the live cart count over a grid of cards, each with a picture, name, weight, price and a quantity field named after the dish beside the add button. Axes: media (image, none), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "count",
      "type": "number",
      "default": 0,
      "docs": "dishes in the cart"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"image\" | \"none\""
      },
      "default": "image"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "dishes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "shopping-bag",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": "stretch"
                  },
                  "children": [
                    {
                      "use": "Group",
                      "props": {
                        "Justify": "end"
                      },
                      "children": [
                        {
                          "organism": "CartCount",
                          "props": {
                            "count": {
                              "$": "count"
                            },
                            "label": {
                              "$": "labels.inCart"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": "1-3",
                        "Class": "gap-4"
                      },
                      "attrs": {
                        "data-slot": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "dishes"
                          },
                          "as": "d",
                          "key": {
                            "$": "d.id"
                          },
                          "do": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "4",
                                "Class": "rounded bg-card inset-ring inset-ring-border overflow-hidden pb-4"
                              },
                              "attrs": {
                                "data-slot": "item"
                              },
                              "children": [
                                {
                                  "when": {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "media"
                                      },
                                      "image"
                                    ]
                                  },
                                  "then": [
                                    {
                                      "organism": "MediaFrame",
                                      "props": {
                                        "alt": {
                                          "$": "d.name"
                                        }
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2",
                                    "Class": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "media"
                                            },
                                            "image"
                                          ]
                                        },
                                        "px-4",
                                        "px-4 pt-4"
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "use": "Group",
                                      "props": {
                                        "Gap": "2",
                                        "Align": "baseline",
                                        "Justify": "between"
                                      },
                                      "children": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "base",
                                            "Weight": "semibold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "d.name"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "xs",
                                            "Class": "text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "d.weight"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "lg",
                                        "Weight": "bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "money",
                                            "args": [
                                              {
                                                "$": "d.price"
                                              },
                                              {
                                                "$": "d.currency"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Box",
                                  "props": {
                                    "Class": "px-4"
                                  },
                                  "children": [
                                    {
                                      "organism": "AddQty",
                                      "props": {
                                        "name": {
                                          "op": "tpl",
                                          "args": [
                                            "{0}-qty-{1}",
                                            {
                                              "$": "id"
                                            },
                                            {
                                              "$": "d.id"
                                            }
                                          ]
                                        },
                                        "dish": {
                                          "$": "d.name"
                                        },
                                        "labels": {
                                          "$": "labels"
                                        }
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    }
  ]
}
