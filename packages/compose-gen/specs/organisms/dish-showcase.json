{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.dish-showcase",
  "name": "DishShowcase",
  "docs": "A showcase of dishes: each card is one link to the dish page (picture, badge, name, weight, summary, price and an arrow). No cart here. Axes: cols (3, 4), ratio (4/3, 1/1), tone.",
  "records": {
    "Dish": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "summary",
        "type": "string"
      },
      {
        "name": "price",
        "type": "number"
      },
      {
        "name": "currency",
        "type": "string"
      },
      {
        "name": "weight",
        "type": "string"
      },
      {
        "name": "tag",
        "type": "string"
      },
      {
        "name": "items",
        "type": "string[]"
      },
      {
        "name": "minutes",
        "type": "number"
      },
      {
        "name": "badge",
        "type": "string",
        "optional": true
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      }
    ],
    "FoodLabels": [
      {
        "name": "add",
        "type": "string"
      },
      {
        "name": "open",
        "type": "string"
      },
      {
        "name": "order",
        "type": "string"
      },
      {
        "name": "qtyOf",
        "type": "string"
      },
      {
        "name": "decreaseOf",
        "type": "string"
      },
      {
        "name": "increaseOf",
        "type": "string"
      },
      {
        "name": "addOf",
        "type": "string"
      },
      {
        "name": "orderOf",
        "type": "string"
      },
      {
        "name": "inCart",
        "type": "string"
      },
      {
        "name": "total",
        "type": "string"
      },
      {
        "name": "minutes",
        "type": "string"
      },
      {
        "name": "ingredients",
        "type": "string"
      },
      {
        "name": "portions",
        "type": "string"
      },
      {
        "name": "size",
        "type": "string"
      },
      {
        "name": "crust",
        "type": "string"
      },
      {
        "name": "perKg",
        "type": "string"
      },
      {
        "name": "weightOf",
        "type": "string"
      },
      {
        "name": "boxFill",
        "type": "string"
      },
      {
        "name": "main",
        "type": "string"
      },
      {
        "name": "side",
        "type": "string"
      },
      {
        "name": "drink",
        "type": "string"
      },
      {
        "name": "meat",
        "type": "string"
      },
      {
        "name": "weight",
        "type": "string"
      },
      {
        "name": "sides",
        "type": "string"
      },
      {
        "name": "summary",
        "type": "string"
      },
      {
        "name": "phone",
        "type": "string"
      },
      {
        "name": "cut",
        "type": "string"
      },
      {
        "name": "heat",
        "type": "string"
      },
      {
        "name": "price",
        "type": "string"
      },
      {
        "name": "marinade",
        "type": "string"
      },
      {
        "name": "caption",
        "type": "string"
      },
      {
        "name": "pieces",
        "type": "string"
      },
      {
        "name": "strip",
        "type": "string"
      },
      {
        "name": "sections",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"3\" | \"4\""
      },
      "default": "3"
    },
    {
      "name": "ratio",
      "type": {
        "ts": "\"4/3\" | \"1/1\""
      },
      "default": "4/3"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "dishes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "star",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "cols"
                            },
                            "4"
                          ]
                        },
                        "2-4",
                        "1-3"
                      ]
                    },
                    "Class": "gap-8"
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "dishes"
                      },
                      "as": "d",
                      "key": {
                        "$": "d.id"
                      },
                      "do": [
                        {
                          "use": "Link",
                          "props": {
                            "Href": {
                              "op": "coalesce",
                              "args": [
                                {
                                  "$": "d.href"
                                },
                                {
                                  "op": "tpl",
                                  "args": [
                                    "#/dish/{0}",
                                    {
                                      "$": "d.id"
                                    }
                                  ]
                                }
                              ]
                            },
                            "Variant": "block",
                            "Class": "group flex-col items-stretch gap-4"
                          },
                          "attrs": {
                            "data-testid": "item"
                          },
                          "children": [
                            {
                              "organism": "MediaFrame",
                              "props": {
                                "alt": {
                                  "$": "d.name"
                                },
                                "ratio": {
                                  "$": "ratio"
                                }
                              }
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2"
                              },
                              "children": [
                                {
                                  "when": {
                                    "$": "d.badge"
                                  },
                                  "then": [
                                    {
                                      "use": "Badge",
                                      "props": {
                                        "Variant": "secondary",
                                        "Size": "sm",
                                        "Class": "w-fit"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "d.badge"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "2",
                                    "Align": "baseline",
                                    "Justify": "between"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-lg font-semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "d.name"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-sm text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "d.weight"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Inline",
                                  "props": {
                                    "Class": "text-sm font-normal text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.summary"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "2",
                                    "Align": "center",
                                    "Justify": "between"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-base font-bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "money",
                                            "args": [
                                              {
                                                "$": "d.price"
                                              },
                                              {
                                                "$": "d.currency"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "flex items-center gap-2 text-sm text-primary"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "labels.open"
                                          }
                                        },
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "arrow-right",
                                            "Size": 16
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
