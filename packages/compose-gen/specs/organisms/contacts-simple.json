{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.contacts-simple",
  "name": "ContactsSimple",
  "docs": "The simple contacts (model contacts@1): the heading, a description and the contacts as a list on a card surface, each with an icon picture (a disc), the name, a line and an action. Axes: layout (cards: columns, the copy centred by the align setting, rows: the icon beside the copy), cols (2, 3 columns).",
  "records": {
    "ContactItem": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "image",
        "type": "string",
        "optional": true
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "description",
        "type": "string",
        "optional": true
      },
      {
        "name": "actionLabel",
        "type": "string",
        "optional": true
      },
      {
        "name": "actionHref",
        "type": "string",
        "optional": true
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "description",
      "type": "string",
      "default": "",
      "docs": "one paragraph under the heading; empty: none"
    },
    {
      "name": "items",
      "type": {
        "ts": "ContactItem[]"
      },
      "required": true,
      "docs": "the contacts, in the order they are shown (1 to 6)"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\" | \"end\""
      },
      "default": "center",
      "docs": "the alignment of the copy: start, center or end (logical, follows the writing direction): items-* on the column, text-* on the text"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"cards\" | \"rows\""
      },
      "default": "cards"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"3\" | \"2\""
      },
      "default": "3"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "column",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "end",
              "start"
            ]
          }
        ]
      }
    },
    {
      "name": "textAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "text-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "text-end",
              "text-start"
            ]
          }
        ]
      }
    },
    {
      "name": "itemsAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "items-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "items-end",
              "items-start"
            ]
          }
        ]
      }
    },
    {
      "name": "selfAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "self-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "self-end",
              ""
            ]
          }
        ]
      }
    },
    {
      "name": "grid",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "cols"
              },
              "2"
            ]
          },
          "md:grid-cols-2",
          "md:grid-cols-3"
        ]
      }
    },
    {
      "name": "item",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "rows"
            ]
          },
          "flex flex-row items-start gap-4",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "center"
                ]
              },
              "flex flex-col items-center gap-4",
              {
                "op": "cond",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "align"
                      },
                      "end"
                    ]
                  },
                  "flex flex-col items-end gap-4",
                  "flex flex-col items-start gap-4"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "copyAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "rows"
            ]
          },
          "start",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "center"
                ]
              },
              "center",
              {
                "op": "cond",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "align"
                      },
                      "end"
                    ]
                  },
                  "end",
                  "start"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "copyText",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "rows"
            ]
          },
          "text-start",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "center"
                ]
              },
              "text-center",
              {
                "op": "cond",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "align"
                      },
                      "end"
                    ]
                  },
                  "text-end",
                  "text-start"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "contacts-simple"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Stack",
              "props": {
                "Gap": "12",
                "Align": "stretch",
                "Class": ""
              },
              "children": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": {
                      "$": "column"
                    },
                    "Class": {
                      "op": "cn",
                      "args": [
                        "max-w-2xl",
                        {
                          "$": "selfAlign"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "use": "Title",
                      "props": {
                        "As": {
                          "$": "level"
                        },
                        "Size": "3xl",
                        "Weight": "bold",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "tracking-tight",
                            {
                              "$": "textAlign"
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "id": {
                          "$": "titleId"
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "description"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "base",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "text-muted-foreground",
                                {
                                  "$": "textAlign"
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "description"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "List",
                  "props": {
                    "Tag": "ul",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "m-0 w-full list-none p-0",
                        {
                          "op": "cn",
                          "args": [
                            "grid grid-cols-1 gap-6",
                            {
                              "$": "grid"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "each": {
                        "$": "items"
                      },
                      "as": "c",
                      "key": {
                        "$": "c.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": {
                              "op": "cn",
                              "args": [
                                "rounded bg-card p-6 text-card-foreground border border-border",
                                {
                                  "$": "item"
                                }
                              ]
                            }
                          },
                          "attrs": {
                            "data-slot": "contact"
                          },
                          "children": [
                            {
                              "organism": "MediaFrame",
                              "props": {
                                "alt": {
                                  "$": "c.title"
                                },
                                "src": {
                                  "$": "c.image"
                                },
                                "ratio": "1/1",
                                "className": "size-12 shrink-0 rounded-full"
                              }
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "4",
                                "Align": {
                                  "$": "copyAlign"
                                }
                              },
                              "children": [
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2",
                                    "Align": {
                                      "$": "copyAlign"
                                    }
                                  },
                                  "children": [
                                    {
                                      "use": "Title",
                                      "props": {
                                        "As": {
                                          "op": "add",
                                          "args": [
                                            {
                                              "$": "level"
                                            },
                                            1
                                          ]
                                        },
                                        "Size": "lg",
                                        "Weight": "semibold",
                                        "Class": {
                                          "$": "copyText"
                                        }
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "c.title"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "when": {
                                        "$": "c.description"
                                      },
                                      "then": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Class": {
                                              "op": "cn",
                                              "args": [
                                                "text-muted-foreground",
                                                {
                                                  "$": "copyText"
                                                }
                                              ]
                                            }
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "c.description"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "when": {
                                    "op": "and",
                                    "args": [
                                      {
                                        "$": "c.actionLabel"
                                      },
                                      {
                                        "$": "c.actionHref"
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "use": "LinkButton",
                                      "props": {
                                        "Variant": "default",
                                        "Size": "sm",
                                        "Href": {
                                          "$": "c.actionHref"
                                        }
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "c.actionLabel"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
