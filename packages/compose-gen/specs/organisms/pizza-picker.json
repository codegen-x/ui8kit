{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.pizza-picker",
  "name": "PizzaPicker",
  "docs": "Pizzas with a picker on each card: the picture, name and toppings, a radio group of sizes and one of crusts (each a fieldset with role radiogroup), the price and an add button. Axes: layout (cards, rows), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "sizes",
      "type": {
        "ts": "DishOption[]"
      },
      "required": true,
      "docs": "the sizes, the first checked"
    },
    {
      "name": "crusts",
      "type": {
        "ts": "DishOption[]"
      },
      "required": true,
      "docs": "the crusts, the first checked"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"cards\" | \"rows\""
      },
      "default": "cards"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "dishes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "star",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "rows"
                          ]
                        },
                        "flex flex-col gap-4",
                        "grid grid-cols-1 gap-4 md:grid-cols-3"
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "dishes"
                      },
                      "as": "d",
                      "key": {
                        "$": "d.id"
                      },
                      "do": [
                        {
                          "use": "Box",
                          "props": {
                            "Class": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "layout"
                                    },
                                    "rows"
                                  ]
                                },
                                "rounded bg-card inset-ring inset-ring-border grid grid-cols-1 gap-4 p-4 md:grid-cols-3",
                                "rounded bg-card inset-ring inset-ring-border flex flex-col gap-4 p-4"
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "item"
                          },
                          "children": [
                            {
                              "organism": "MediaFrame",
                              "props": {
                                "alt": {
                                  "$": "d.name"
                                },
                                "ratio": "1/1"
                              }
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "4",
                                "Class": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "rows"
                                      ]
                                    },
                                    "md:col-span-2",
                                    ""
                                  ]
                                }
                              },
                              "children": [
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2"
                                  },
                                  "children": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "lg",
                                        "Weight": "semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "d.name"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "d.summary"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "organism": "OptionChips",
                                  "props": {
                                    "name": {
                                      "op": "tpl",
                                      "args": [
                                        "{0}-size-{1}",
                                        {
                                          "$": "id"
                                        },
                                        {
                                          "$": "d.id"
                                        }
                                      ]
                                    },
                                    "legend": {
                                      "$": "labels.size"
                                    },
                                    "options": {
                                      "$": "sizes"
                                    }
                                  }
                                },
                                {
                                  "organism": "OptionChips",
                                  "props": {
                                    "name": {
                                      "op": "tpl",
                                      "args": [
                                        "{0}-crust-{1}",
                                        {
                                          "$": "id"
                                        },
                                        {
                                          "$": "d.id"
                                        }
                                      ]
                                    },
                                    "legend": {
                                      "$": "labels.crust"
                                    },
                                    "options": {
                                      "$": "crusts"
                                    }
                                  }
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "center",
                                    "Justify": "between",
                                    "Class": "mt-auto"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-xl font-bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "money",
                                            "args": [
                                              {
                                                "$": "d.price"
                                              },
                                              {
                                                "$": "d.currency"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Button",
                                      "props": {
                                        "Variant": "default",
                                        "Size": "default",
                                        "Type": "button",
                                        "AriaLabel": {
                                          "op": "tpl",
                                          "args": [
                                            {
                                              "$": "labels.addOf"
                                            },
                                            {
                                              "$": "d.name"
                                            }
                                          ]
                                        }
                                      },
                                      "attrs": {
                                        "data-testid": "add"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "labels.add"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    },
    {
      "from": "OptionChips",
      "names": [
        "DishOption"
      ]
    }
  ]
}
