{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.stories-simple",
  "name": "StoriesSimple",
  "docs": "The simple stories (model stories@1): the heading, a description and the stories (posts) as a list, each with a cover picture, the title (a link when the story has an address) and a line. Axes: layout (grid: cards in columns, compact: small covers beside the copy on a card surface), cols (2, 3 columns).",
  "records": {
    "SimpleStory": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "image",
        "type": "string",
        "optional": true
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "description",
        "type": "string",
        "optional": true
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "description",
      "type": "string",
      "default": "",
      "docs": "one paragraph under the heading; empty: none"
    },
    {
      "name": "stories",
      "type": {
        "ts": "SimpleStory[]"
      },
      "required": true,
      "docs": "the stories, in the order they are shown (1 to 6)"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\" | \"end\""
      },
      "default": "center",
      "docs": "the alignment of the copy: start, center or end (logical, follows the writing direction): items-* on the column, text-* on the text"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"compact\""
      },
      "default": "grid"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"2\" | \"3\""
      },
      "default": "3"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "column",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "end",
              "start"
            ]
          }
        ]
      }
    },
    {
      "name": "textAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "text-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "text-end",
              "text-start"
            ]
          }
        ]
      }
    },
    {
      "name": "itemsAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "items-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "items-end",
              "items-start"
            ]
          }
        ]
      }
    },
    {
      "name": "selfAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "self-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "self-end",
              ""
            ]
          }
        ]
      }
    },
    {
      "name": "grid",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "cols"
              },
              "2"
            ]
          },
          "md:grid-cols-2",
          "md:grid-cols-3"
        ]
      }
    },
    {
      "name": "item",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "compact"
            ]
          },
          "flex flex-row items-center gap-4 rounded bg-card p-4 text-card-foreground border border-border",
          "flex flex-col gap-4"
        ]
      }
    },
    {
      "name": "coverRatio",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "compact"
            ]
          },
          "1/1",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "cols"
                  },
                  "2"
                ]
              },
              "16/9",
              "4/3"
            ]
          }
        ]
      }
    },
    {
      "name": "cover",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "compact"
            ]
          },
          "size-16 shrink-0",
          ""
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "stories-simple"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Stack",
              "props": {
                "Gap": "12",
                "Align": "stretch"
              },
              "children": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": {
                      "$": "column"
                    },
                    "Class": {
                      "op": "cn",
                      "args": [
                        "max-w-2xl",
                        {
                          "$": "selfAlign"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "use": "Title",
                      "props": {
                        "As": {
                          "$": "level"
                        },
                        "Size": "3xl",
                        "Weight": "bold",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "tracking-tight",
                            {
                              "$": "textAlign"
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "id": {
                          "$": "titleId"
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "description"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "base",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "text-muted-foreground",
                                {
                                  "$": "textAlign"
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "description"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "List",
                  "props": {
                    "Tag": "ul",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "m-0 list-none p-0",
                        {
                          "op": "cn",
                          "args": [
                            "grid grid-cols-1 gap-8",
                            {
                              "$": "grid"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "each": {
                        "$": "stories"
                      },
                      "as": "s",
                      "key": {
                        "$": "s.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": {
                              "$": "item"
                            }
                          },
                          "attrs": {
                            "data-slot": "story"
                          },
                          "children": [
                            {
                              "organism": "MediaFrame",
                              "props": {
                                "alt": {
                                  "$": "s.title"
                                },
                                "src": {
                                  "$": "s.image"
                                },
                                "ratio": {
                                  "$": "coverRatio"
                                },
                                "className": {
                                  "$": "cover"
                                }
                              }
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2",
                                "Align": "start"
                              },
                              "children": [
                                {
                                  "when": {
                                    "$": "s.href"
                                  },
                                  "then": [
                                    {
                                      "use": "Link",
                                      "props": {
                                        "Href": {
                                          "$": "s.href"
                                        },
                                        "Variant": "block"
                                      },
                                      "children": [
                                        {
                                          "use": "Title",
                                          "props": {
                                            "As": {
                                              "op": "add",
                                              "args": [
                                                {
                                                  "$": "level"
                                                },
                                                1
                                              ]
                                            },
                                            "Size": "lg",
                                            "Weight": "semibold",
                                            "Class": "text-start"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "s.title"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ],
                                  "else": [
                                    {
                                      "use": "Title",
                                      "props": {
                                        "As": {
                                          "op": "add",
                                          "args": [
                                            {
                                              "$": "level"
                                            },
                                            1
                                          ]
                                        },
                                        "Size": "lg",
                                        "Weight": "semibold",
                                        "Class": "text-start"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "s.title"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "when": {
                                    "$": "s.description"
                                  },
                                  "then": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Class": {
                                          "op": "cn",
                                          "args": [
                                            "text-muted-foreground",
                                            "text-start"
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "s.description"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
