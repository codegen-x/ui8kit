{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.profile-intro",
  "name": "ProfileIntro",
  "docs": "The profile intro (model profile@1): the name as the heading, the role (the primary token), a description, the links of the person as a list of small outline links, and the portrait. Axes: media (end: the portrait after the copy, start: before it from md up, top: a disc over the copy).",
  "records": {
    "ProfileLink": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "label",
        "type": "string"
      },
      {
        "name": "href",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "docs": "the name of the person (the heading)"
    },
    {
      "name": "role",
      "type": "string",
      "required": true,
      "docs": "the role and the company"
    },
    {
      "name": "description",
      "type": "string",
      "default": "",
      "docs": "one paragraph under the heading; empty: none"
    },
    {
      "name": "image",
      "type": "string",
      "default": "",
      "docs": "address of the picture; none: the placeholder"
    },
    {
      "name": "imageAlt",
      "type": "string",
      "required": true,
      "docs": "alt text of the picture"
    },
    {
      "name": "links",
      "type": {
        "ts": "ProfileLink[]"
      },
      "required": true,
      "docs": "the links of the person, in the order they are shown (0 to 4)"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\" | \"end\""
      },
      "default": "start",
      "docs": "the alignment of the copy: start, center or end (logical, follows the writing direction): items-* on the column, text-* on the text"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"end\" | \"start\" | \"top\""
      },
      "default": "end"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "column",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "end",
              "start"
            ]
          }
        ]
      }
    },
    {
      "name": "textAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "text-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "text-end",
              "text-start"
            ]
          }
        ]
      }
    },
    {
      "name": "itemsAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "items-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "items-end",
              "items-start"
            ]
          }
        ]
      }
    },
    {
      "name": "selfAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "self-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "self-end",
              ""
            ]
          }
        ]
      }
    },
    {
      "name": "frame",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "media"
              },
              "top"
            ]
          },
          "flex flex-col items-center gap-8",
          "grid grid-cols-1 items-center gap-12 md:grid-cols-2"
        ]
      }
    },
    {
      "name": "pictureCell",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "media"
              },
              "top"
            ]
          },
          "order-first w-full",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "media"
                  },
                  "start"
                ]
              },
              "order-first w-full",
              "w-full"
            ]
          }
        ]
      }
    },
    {
      "name": "pictureClass",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "media"
              },
              "top"
            ]
          },
          "mx-auto size-32 rounded-full",
          "mx-auto w-full max-w-sm"
        ]
      }
    },
    {
      "name": "linkRow",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "justify-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "justify-end",
              "justify-start"
            ]
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "profile-intro"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "$": "frame"
                }
              },
              "children": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": {
                      "$": "column"
                    }
                  },
                  "children": [
                    {
                      "use": "Title",
                      "props": {
                        "As": {
                          "$": "level"
                        },
                        "Size": "4xl",
                        "Weight": "bold",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "tracking-tight",
                            {
                              "$": "textAlign"
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "id": {
                          "$": "titleId"
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "lg",
                        "Weight": "medium",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "text-primary",
                            {
                              "$": "textAlign"
                            }
                          ]
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "role"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "description"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "base",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "text-muted-foreground",
                                {
                                  "$": "textAlign"
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "description"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "List",
                      "props": {
                        "Tag": "ul",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "m-0 w-full list-none p-0",
                            {
                              "op": "cn",
                              "args": [
                                "flex flex-wrap gap-2",
                                {
                                  "$": "linkRow"
                                }
                              ]
                            }
                          ]
                        }
                      },
                      "children": [
                        {
                          "each": {
                            "$": "links"
                          },
                          "as": "l",
                          "key": {
                            "$": "l.id"
                          },
                          "do": [
                            {
                              "use": "ListItem",
                              "attrs": {
                                "data-slot": "profile-link"
                              },
                              "children": [
                                {
                                  "use": "LinkButton",
                                  "props": {
                                    "Variant": "outline",
                                    "Size": "sm",
                                    "Href": {
                                      "$": "l.href"
                                    }
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "l.label"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "$": "pictureCell"
                    }
                  },
                  "children": [
                    {
                      "organism": "MediaFrame",
                      "props": {
                        "alt": {
                          "$": "imageAlt"
                        },
                        "src": {
                          "$": "image"
                        },
                        "ratio": "1/1",
                        "className": {
                          "$": "pictureClass"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
