{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.amenities-simple",
  "name": "AmenitiesSimple",
  "docs": "The simple amenities (model amenities@1): the heading, a description and the amenities as a list of short names. Text only. Axes: layout (grid: muted rows in columns; pills: outlined pills in a wrapping row, placed by the align setting), cols (3, 2 columns of the grid from md up).",
  "records": {
    "Amenity": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "description",
      "type": "string",
      "default": "",
      "docs": "one paragraph under the heading; empty: none"
    },
    {
      "name": "items",
      "type": {
        "ts": "Amenity[]"
      },
      "required": true,
      "docs": "the amenities, in the order they are shown (2 to 16)"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\" | \"end\""
      },
      "default": "center",
      "docs": "the alignment of the copy: start, center or end (logical, follows the writing direction): items-* on the column, text-* on the text"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"pills\""
      },
      "default": "grid"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"3\" | \"2\""
      },
      "default": "3"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "column",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "end",
              "start"
            ]
          }
        ]
      }
    },
    {
      "name": "textAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "text-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "text-end",
              "text-start"
            ]
          }
        ]
      }
    },
    {
      "name": "itemsAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "items-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "items-end",
              "items-start"
            ]
          }
        ]
      }
    },
    {
      "name": "selfAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "self-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "self-end",
              ""
            ]
          }
        ]
      }
    },
    {
      "name": "grid",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "pills"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "center"
                ]
              }
            ]
          },
          "flex flex-wrap justify-center gap-2",
          {
            "op": "cond",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "pills"
                    ]
                  },
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "align"
                      },
                      "end"
                    ]
                  }
                ]
              },
              "flex flex-wrap justify-end gap-2",
              {
                "op": "cond",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "pills"
                    ]
                  },
                  "flex flex-wrap gap-2",
                  {
                    "op": "cond",
                    "args": [
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "cols"
                          },
                          "2"
                        ]
                      },
                      "grid grid-cols-1 gap-4 sm:grid-cols-2",
                      "grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "item",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "pills"
            ]
          },
          "rounded border border-border px-4 py-2",
          "rounded bg-muted px-4 py-4"
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "amenities-simple"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Stack",
              "props": {
                "Gap": "12",
                "Align": "stretch",
                "Class": ""
              },
              "children": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": {
                      "$": "column"
                    },
                    "Class": {
                      "op": "cn",
                      "args": [
                        "max-w-2xl",
                        {
                          "$": "selfAlign"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "use": "Title",
                      "props": {
                        "As": {
                          "$": "level"
                        },
                        "Size": "3xl",
                        "Weight": "bold",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "tracking-tight",
                            {
                              "$": "textAlign"
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "id": {
                          "$": "titleId"
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "description"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "base",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "text-muted-foreground",
                                {
                                  "$": "textAlign"
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "description"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "List",
                  "props": {
                    "Tag": "ul",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "m-0 w-full list-none p-0",
                        {
                          "$": "grid"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "each": {
                        "$": "items"
                      },
                      "as": "a",
                      "key": {
                        "$": "a.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": {
                              "$": "item"
                            }
                          },
                          "attrs": {
                            "data-slot": "amenity"
                          },
                          "children": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "base",
                                "Weight": "medium",
                                "Class": "text-start"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "a.title"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
