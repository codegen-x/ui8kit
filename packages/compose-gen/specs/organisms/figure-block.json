{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.figure-block",
  "name": "FigureBlock",
  "docs": "Self-contained content with an optional caption (a quote, a picture, a stat) in its own file: Block tag figure.",
  "records": {},
  "props": [
    {
      "name": "testid",
      "type": "string",
      "docs": "data-slot of the root (default: the component name)"
    }
  ],
  "className": true,
  "children": true,
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "figure",
        "Class": {
          "op": "cn",
          "args": [
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "data-slot": {
          "op": "coalesce",
          "args": [
            {
              "$": "testid"
            },
            "figure-block"
          ]
        }
      },
      "children": [
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
