{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.team-simple",
  "name": "TeamSimple",
  "docs": "The simple team (model team@1): the heading, a description and the members as a list, each with a portrait, the name and a line. Axes: cols (2, 3, 4 columns from md up), surface (plain, cards).",
  "records": {
    "SimpleMember": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "avatar",
        "type": "string",
        "optional": true
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "description",
        "type": "string",
        "optional": true
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "description",
      "type": "string",
      "default": "",
      "docs": "one paragraph under the heading; empty: none"
    },
    {
      "name": "members",
      "type": {
        "ts": "SimpleMember[]"
      },
      "required": true,
      "docs": "the people, in the order they are shown (1 to 12)"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\" | \"end\""
      },
      "default": "start",
      "docs": "the alignment of the copy: start, center or end (logical, follows the writing direction): items-* on the column, text-* on the text"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"2\" | \"3\" | \"4\""
      },
      "default": "3"
    },
    {
      "name": "surface",
      "type": {
        "ts": "\"plain\" | \"cards\""
      },
      "default": "plain"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "column",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "end",
              "start"
            ]
          }
        ]
      }
    },
    {
      "name": "textAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "text-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "text-end",
              "text-start"
            ]
          }
        ]
      }
    },
    {
      "name": "itemsAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "items-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "items-end",
              "items-start"
            ]
          }
        ]
      }
    },
    {
      "name": "selfAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "self-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "self-end",
              ""
            ]
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "team-simple"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Stack",
              "props": {
                "Gap": "12",
                "Align": "stretch"
              },
              "children": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": {
                      "$": "column"
                    },
                    "Class": {
                      "op": "cn",
                      "args": [
                        "max-w-2xl",
                        {
                          "$": "selfAlign"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "use": "Title",
                      "props": {
                        "As": {
                          "$": "level"
                        },
                        "Size": "3xl",
                        "Weight": "bold",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "tracking-tight",
                            {
                              "$": "textAlign"
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "id": {
                          "$": "titleId"
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "description"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "base",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "text-muted-foreground",
                                {
                                  "$": "textAlign"
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "description"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "List",
                  "props": {
                    "Tag": "ul",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "m-0 grid w-full list-none grid-cols-1 gap-8 p-0 sm:grid-cols-2",
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "cols"
                                },
                                "2"
                              ]
                            },
                            "",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "cols"
                                    },
                                    "3"
                                  ]
                                },
                                "md:grid-cols-3",
                                "md:grid-cols-4"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "each": {
                        "$": "members"
                      },
                      "as": "m",
                      "key": {
                        "$": "m.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "surface"
                                    },
                                    "cards"
                                  ]
                                },
                                "flex",
                                {
                                  "op": "cn",
                                  "args": [
                                    "flex flex-col gap-4",
                                    {
                                      "$": "itemsAlign"
                                    }
                                  ]
                                }
                              ]
                            }
                          },
                          "attrs": {
                            "data-slot": "member"
                          },
                          "children": [
                            {
                              "when": {
                                "op": "eq",
                                "args": [
                                  {
                                    "$": "surface"
                                  },
                                  "cards"
                                ]
                              },
                              "then": [
                                {
                                  "use": "Card",
                                  "props": {
                                    "Class": {
                                      "op": "cn",
                                      "args": [
                                        "flex w-full flex-col gap-4 p-6",
                                        {
                                          "$": "itemsAlign"
                                        }
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "organism": "MediaFrame",
                                      "props": {
                                        "alt": {
                                          "$": "m.title"
                                        },
                                        "src": {
                                          "$": "m.avatar"
                                        },
                                        "ratio": "1/1",
                                        "className": "size-16 rounded-full"
                                      }
                                    },
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "2",
                                        "Align": {
                                          "$": "column"
                                        }
                                      },
                                      "children": [
                                        {
                                          "use": "Title",
                                          "props": {
                                            "As": {
                                              "op": "add",
                                              "args": [
                                                {
                                                  "$": "level"
                                                },
                                                1
                                              ]
                                            },
                                            "Size": "lg",
                                            "Weight": "semibold",
                                            "Class": {
                                              "$": "textAlign"
                                            }
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "m.title"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "when": {
                                            "$": "m.description"
                                          },
                                          "then": [
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "sm",
                                                "Class": {
                                                  "op": "cn",
                                                  "args": [
                                                    "text-muted-foreground",
                                                    {
                                                      "$": "textAlign"
                                                    }
                                                  ]
                                                }
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "m.description"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ],
                              "else": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "m.title"
                                    },
                                    "src": {
                                      "$": "m.avatar"
                                    },
                                    "ratio": "1/1",
                                    "className": "size-16 rounded-full"
                                  }
                                },
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2",
                                    "Align": {
                                      "$": "column"
                                    }
                                  },
                                  "children": [
                                    {
                                      "use": "Title",
                                      "props": {
                                        "As": {
                                          "op": "add",
                                          "args": [
                                            {
                                              "$": "level"
                                            },
                                            1
                                          ]
                                        },
                                        "Size": "lg",
                                        "Weight": "semibold",
                                        "Class": {
                                          "$": "textAlign"
                                        }
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "m.title"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "when": {
                                        "$": "m.description"
                                      },
                                      "then": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Class": {
                                              "op": "cn",
                                              "args": [
                                                "text-muted-foreground",
                                                {
                                                  "$": "textAlign"
                                                }
                                              ]
                                            }
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "m.description"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
