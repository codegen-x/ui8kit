{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.error-simple",
  "name": "ErrorSimple",
  "docs": "The simple error (model error@1): the code (large, the primary token), the heading, a description and one action back. Text only. The align setting places it: centred or at the start.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "code",
      "type": "string",
      "required": true,
      "docs": "the code as it is shown (404)"
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "description",
      "type": "string",
      "default": "",
      "docs": "one paragraph under the heading; empty: none"
    },
    {
      "name": "actionLabel",
      "type": "string",
      "default": "",
      "docs": "the label of the action; the link is drawn when the label and the address are both set"
    },
    {
      "name": "actionHref",
      "type": "string",
      "default": "",
      "docs": "the address of the action"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2 | 3"
      },
      "default": 2,
      "docs": "the level of the heading (1 on the first section of a page)"
    },
    {
      "name": "padding",
      "type": {
        "ts": "\"compact\" | \"standard\" | \"spacious\""
      },
      "default": "standard",
      "docs": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\" | \"end\""
      },
      "default": "center",
      "docs": "the alignment of the copy: start, center or end (logical, follows the writing direction): items-* on the column, text-* on the text"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "column",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "end",
              "start"
            ]
          }
        ]
      }
    },
    {
      "name": "textAlign",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "align"
              },
              "center"
            ]
          },
          "text-center",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "align"
                  },
                  "end"
                ]
              },
              "text-end",
              "text-start"
            ]
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "padding"
                },
                "compact"
              ]
            },
            "py-8 lg:py-16",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "padding"
                    },
                    "spacious"
                  ]
                },
                "py-24 lg:py-40",
                "py-16 lg:py-32"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "$": "titleId"
            }
          ]
        },
        "aria-label": {
          "$": "landmarkLabel"
        },
        "data-slot": "error-simple"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "children": [
            {
              "use": "Stack",
              "props": {
                "Gap": "6",
                "Align": {
                  "$": "column"
                },
                "Justify": "center",
                "Class": "min-h-96"
              },
              "children": [
                {
                  "use": "Text",
                  "props": {
                    "Size": "5xl",
                    "Weight": "bold",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "tracking-tight text-primary",
                        {
                          "$": "textAlign"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "text": {
                        "$": "code"
                      }
                    }
                  ]
                },
                {
                  "use": "Title",
                  "props": {
                    "As": {
                      "$": "level"
                    },
                    "Size": "4xl",
                    "Weight": "bold",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "tracking-tight",
                        {
                          "$": "textAlign"
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "id": {
                      "$": "titleId"
                    }
                  },
                  "children": [
                    {
                      "text": {
                        "$": "title"
                      }
                    }
                  ]
                },
                {
                  "when": {
                    "$": "description"
                  },
                  "then": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "lg",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "max-w-2xl text-muted-foreground",
                            {
                              "$": "textAlign"
                            }
                          ]
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "description"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "and",
                    "args": [
                      {
                        "$": "actionLabel"
                      },
                      {
                        "$": "actionHref"
                      }
                    ]
                  },
                  "then": [
                    {
                      "use": "LinkButton",
                      "props": {
                        "Variant": "default",
                        "Size": "lg",
                        "Href": {
                          "$": "actionHref"
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "actionLabel"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
