{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.dish-bento",
  "name": "DishBento",
  "docs": "Featured dishes as a bento: the first dish in a large tile (two by two) with its summary and a link to its page, the others in small tiles around it. Axes: feature (start, end), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "dishes",
      "type": {
        "ts": "Dish[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "FoodLabels"
      },
      "required": true
    },
    {
      "name": "feature",
      "type": {
        "ts": "\"start\" | \"end\""
      },
      "default": "start"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "dishes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "star",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "dishes"
                      },
                      "as": "d",
                      "key": {
                        "$": "d.id"
                      },
                      "do": [
                        {
                          "when": {
                            "op": "eq",
                            "args": [
                              {
                                "$": "i"
                              },
                              0
                            ]
                          },
                          "then": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "4",
                                "Class": {
                                  "op": "cn",
                                  "args": [
                                    "rounded bg-card inset-ring inset-ring-border p-6 sm:col-span-2 lg:row-span-2",
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "feature"
                                            },
                                            "end"
                                          ]
                                        },
                                        "lg:col-start-3 lg:row-start-1",
                                        ""
                                      ]
                                    }
                                  ]
                                }
                              },
                              "attrs": {
                                "data-testid": "feature"
                              },
                              "children": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "d.name"
                                    },
                                    "ratio": "4/3"
                                  }
                                },
                                {
                                  "use": "Badge",
                                  "props": {
                                    "Variant": "secondary",
                                    "Size": "default",
                                    "Class": "w-fit"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.weight"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Title",
                                  "props": {
                                    "As": 3,
                                    "Size": "2xl",
                                    "Weight": "bold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.name"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "base",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.summary"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "center",
                                    "Justify": "between",
                                    "Class": "mt-auto"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-xl font-bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "money",
                                            "args": [
                                              {
                                                "$": "d.price"
                                              },
                                              {
                                                "$": "d.currency"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Link",
                                      "props": {
                                        "Href": {
                                          "op": "coalesce",
                                          "args": [
                                            {
                                              "$": "d.href"
                                            },
                                            {
                                              "op": "tpl",
                                              "args": [
                                                "#/dish/{0}",
                                                {
                                                  "$": "d.id"
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        "Variant": "default"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "labels.open"
                                          }
                                        },
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "arrow-right",
                                            "Size": 16
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "else": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2",
                                "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "d.name"
                                    }
                                  }
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.name"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "2",
                                    "Align": "center",
                                    "Justify": "between"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-sm font-bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "money",
                                            "args": [
                                              {
                                                "$": "d.price"
                                              },
                                              {
                                                "$": "d.currency"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "organism": "AddIcon",
                                      "props": {
                                        "label": {
                                          "op": "tpl",
                                          "args": [
                                            {
                                              "$": "labels.addOf"
                                            },
                                            {
                                              "$": "d.name"
                                            }
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "index": "i"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "typeImports": [
    {
      "from": "DishShowcase",
      "names": [
        "Dish",
        "FoodLabels"
      ]
    }
  ]
}
