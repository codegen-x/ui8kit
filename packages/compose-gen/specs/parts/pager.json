{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "part.pager",
  "name": "Pager",
  "docs": "The list footer: a summary line and previous / next page buttons. With `numbered` it shows page numbers (1 … 4 5 6 … 21), with `moreLabel` a \"Load more\" button. The current page is a plain element marked aria-current=\"page\"; the others are buttons, or links with `pageUrl` (the address of page {0}; `firstUrl` for page 1): a disabled previous / next stays a disabled button, without an address. All text comes in through props.",
  "records": {},
  "props": [
    {
      "name": "page",
      "type": "number",
      "docs": "current page, from 1",
      "required": true
    },
    {
      "name": "pages",
      "type": "number",
      "docs": "number of pages",
      "required": true
    },
    {
      "name": "summary",
      "type": "string",
      "required": true
    },
    {
      "name": "previousLabel",
      "type": "string",
      "required": true
    },
    {
      "name": "nextLabel",
      "type": "string",
      "required": true
    },
    {
      "name": "numbered",
      "type": "boolean",
      "docs": "show page numbers between the arrows",
      "default": false
    },
    {
      "name": "pageLabel",
      "type": "string",
      "docs": "template of the accessible name of a page button, {0} is the number"
    },
    {
      "name": "moreLabel",
      "type": "string",
      "docs": "label of the \"Load more\" button; no button without it"
    },
    {
      "name": "pageUrl",
      "type": "string",
      "docs": "address of page {0} (/blog/page/{0}/, ?paged={0}, #/posts/{0}); with it every page and previous / next is a link"
    },
    {
      "name": "firstUrl",
      "type": "string",
      "docs": "address of page 1 when it is not pageUrl with 1 (the list's own address)"
    }
  ],
  "derived": [
    {
      "name": "numbers",
      "value": {
        "op": "pageWindow",
        "args": [
          {
            "$": "page"
          },
          {
            "$": "pages"
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "page",
      "args": [
        {
          "name": "page",
          "type": "number"
        }
      ],
      "docs": "a page was chosen"
    },
    {
      "name": "more",
      "args": [],
      "docs": "the load-more button was pressed"
    }
  ],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": "flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-muted-foreground"
      },
      "attrs": {
        "data-testid": "pager"
      },
      "children": [
        {
          "use": "Inline",
          "props": {
            "Class": "flex flex-wrap items-center gap-4"
          },
          "children": [
            {
              "use": "Inline",
              "children": [
                {
                  "text": {
                    "$": "summary"
                  }
                }
              ]
            }
          ]
        },
        {
          "use": "Inline",
          "props": {
            "Class": "flex flex-wrap items-center gap-2"
          },
          "children": [
            {
              "when": {
                "op": "and",
                "args": [
                  {
                    "$": "moreLabel"
                  },
                  {
                    "op": "lt",
                    "args": [
                      {
                        "$": "page"
                      },
                      {
                        "$": "pages"
                      }
                    ]
                  }
                ]
              },
              "then": [
                {
                  "use": "Button",
                  "props": {
                    "Variant": "outline",
                    "Size": "sm",
                    "Type": "button"
                  },
                  "attrs": {
                    "data-testid": "pager-more"
                  },
                  "on": {
                    "click": {
                      "call": "emit.more",
                      "args": []
                    }
                  },
                  "children": [
                    {
                      "text": {
                        "$": "moreLabel"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "use": "Button",
              "props": {
                "Variant": "outline",
                "Size": "sm",
                "Layout": "icon",
                "AriaLabel": {
                  "$": "previousLabel"
                },
                "Disabled": {
                  "op": "le",
                  "args": [
                    {
                      "$": "page"
                    },
                    1
                  ]
                },
                "Href": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "le",
                      "args": [
                        {
                          "$": "page"
                        },
                        1
                      ]
                    },
                    {
                      "op": "undef",
                      "args": []
                    },
                    {
                      "op": "cond",
                      "args": [
                        {
                          "$": "pageUrl"
                        },
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "and",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "op": "sub",
                                      "args": [
                                        {
                                          "$": "page"
                                        },
                                        1
                                      ]
                                    },
                                    1
                                  ]
                                },
                                {
                                  "$": "firstUrl"
                                }
                              ]
                            },
                            {
                              "$": "firstUrl"
                            },
                            {
                              "op": "tpl",
                              "args": [
                                {
                                  "$": "pageUrl"
                                },
                                {
                                  "op": "sub",
                                  "args": [
                                    {
                                      "$": "page"
                                    },
                                    1
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "op": "undef",
                          "args": []
                        }
                      ]
                    }
                  ]
                }
              },
              "on": {
                "click": {
                  "call": "emit.page",
                  "args": [
                    {
                      "op": "sub",
                      "args": [
                        {
                          "$": "page"
                        },
                        1
                      ]
                    }
                  ]
                }
              },
              "children": [
                {
                  "use": "LucideIcon",
                  "props": {
                    "Name": "chevron-left",
                    "Size": 16
                  }
                }
              ]
            },
            {
              "when": {
                "$": "numbered"
              },
              "then": [
                {
                  "each": {
                    "$": "numbers"
                  },
                  "as": "n",
                  "key": {
                    "op": "or",
                    "args": [
                      {
                        "$": "n"
                      },
                      {
                        "op": "tpl",
                        "args": [
                          "gap{0}",
                          {
                            "$": "i"
                          }
                        ]
                      }
                    ]
                  },
                  "do": [
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "n"
                          },
                          null
                        ]
                      },
                      "then": [
                        {
                          "use": "Inline",
                          "props": {
                            "Class": "w-8 text-center"
                          },
                          "children": [
                            {
                              "text": "…"
                            }
                          ]
                        }
                      ],
                      "else": [
                        {
                          "when": {
                            "op": "eq",
                            "args": [
                              {
                                "$": "n"
                              },
                              {
                                "$": "page"
                              }
                            ]
                          },
                          "then": [
                            {
                              "use": "Inline",
                              "props": {
                                "Class": "flex h-8 min-w-8 items-center justify-center rounded bg-foreground px-2 font-bold text-background"
                              },
                              "attrs": {
                                "aria-current": "page",
                                "data-testid": "pager-current"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "n"
                                  }
                                }
                              ]
                            }
                          ],
                          "else": [
                            {
                              "use": "Button",
                              "props": {
                                "Variant": "ghost",
                                "Size": "sm",
                                "Layout": "icon",
                                "Type": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "$": "pageUrl"
                                    },
                                    {
                                      "op": "undef",
                                      "args": []
                                    },
                                    "button"
                                  ]
                                },
                                "AriaLabel": {
                                  "op": "tpl",
                                  "args": [
                                    {
                                      "$": "pageLabel"
                                    },
                                    {
                                      "$": "n"
                                    }
                                  ]
                                },
                                "Href": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "$": "pageUrl"
                                    },
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "and",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "n"
                                                },
                                                1
                                              ]
                                            },
                                            {
                                              "$": "firstUrl"
                                            }
                                          ]
                                        },
                                        {
                                          "$": "firstUrl"
                                        },
                                        {
                                          "op": "tpl",
                                          "args": [
                                            {
                                              "$": "pageUrl"
                                            },
                                            {
                                              "$": "n"
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "op": "undef",
                                      "args": []
                                    }
                                  ]
                                }
                              },
                              "on": {
                                "click": {
                                  "call": "emit.page",
                                  "args": [
                                    {
                                      "$": "n"
                                    }
                                  ]
                                }
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "n"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "index": "i"
                }
              ],
              "else": [
                {
                  "use": "Inline",
                  "props": {
                    "Class": "min-w-12 text-center font-bold text-foreground"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "page"
                      }
                    },
                    {
                      "text": " / "
                    },
                    {
                      "text": {
                        "$": "pages"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "use": "Button",
              "props": {
                "Variant": "outline",
                "Size": "sm",
                "Layout": "icon",
                "AriaLabel": {
                  "$": "nextLabel"
                },
                "Disabled": {
                  "op": "ge",
                  "args": [
                    {
                      "$": "page"
                    },
                    {
                      "$": "pages"
                    }
                  ]
                },
                "Href": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "ge",
                      "args": [
                        {
                          "$": "page"
                        },
                        {
                          "$": "pages"
                        }
                      ]
                    },
                    {
                      "op": "undef",
                      "args": []
                    },
                    {
                      "op": "cond",
                      "args": [
                        {
                          "$": "pageUrl"
                        },
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "and",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "op": "add",
                                      "args": [
                                        {
                                          "$": "page"
                                        },
                                        1
                                      ]
                                    },
                                    1
                                  ]
                                },
                                {
                                  "$": "firstUrl"
                                }
                              ]
                            },
                            {
                              "$": "firstUrl"
                            },
                            {
                              "op": "tpl",
                              "args": [
                                {
                                  "$": "pageUrl"
                                },
                                {
                                  "op": "add",
                                  "args": [
                                    {
                                      "$": "page"
                                    },
                                    1
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "op": "undef",
                          "args": []
                        }
                      ]
                    }
                  ]
                }
              },
              "on": {
                "click": {
                  "call": "emit.page",
                  "args": [
                    {
                      "op": "add",
                      "args": [
                        {
                          "$": "page"
                        },
                        1
                      ]
                    }
                  ]
                }
              },
              "children": [
                {
                  "use": "LucideIcon",
                  "props": {
                    "Name": "chevron-right",
                    "Size": 16
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  }
}
