{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.media-frame",
  "name": "MediaFrame",
  "docs": "A picture in a fixed ratio that follows the theme. `src` is the picture of the light theme, `darkSrc` the one of the dark theme (without it the dark theme shows `src`). Without both (an empty string counts as none) it shows the built-in neutral placeholders (base64 data URIs, one light and one dark), so a page can be laid out before it has pictures; the placeholder is decorative (`alt` is empty), stands in for a real `src` and is switched by the theme token. A real picture gets `alt` and loads lazily. `ratio` comes from the recipe; the corners are the plain theme radius. `srcset` lists sizes of `src` (written by an export, e.g. WebP 960w / 1280w / 1920w) and `sizes` says how wide the picture is shown, so the browser picks a size; the dark picture takes the srcset only when it is `src` (no `darkSrc`).",
  "records": {},
  "props": [
    {
      "name": "alt",
      "type": "string",
      "docs": "accessible name of the picture; used only when there is a `src` (the placeholder is decorative)",
      "required": true
    },
    {
      "name": "src",
      "type": "string",
      "docs": "address of the picture (light theme); none or empty: the built-in light placeholder"
    },
    {
      "name": "darkSrc",
      "type": "string",
      "docs": "address of the picture for the dark theme; none or empty: `src`, or the built-in dark placeholder when there is no `src`"
    },
    {
      "name": "ratio",
      "type": {
        "ts": "\"16/9\" | \"4/3\" | \"1/1\" | \"3/4\" | \"21/9\""
      },
      "docs": "width to height",
      "default": "16/9"
    },
    {
      "name": "srcset",
      "type": "string",
      "docs": "sizes of `src` as a srcset (`hero-960.webp 960w, hero-1280.webp 1280w`); used only with a `src`, for the dark theme only without `darkSrc`"
    },
    {
      "name": "sizes",
      "type": "string",
      "docs": "how wide the picture is shown (the `sizes` of the srcset)",
      "default": "100vw"
    }
  ],
  "className": true,
  "recipes": {
    "mediaFrame": "media-frame"
  },
  "consts": {
    "PLACEHOLDER": {
      "light": "data:image/svg+xml;base64,",
      "dark": "data:image/svg+xml;base64,"
    }
  },
  "derived": [
    {
      "name": "lightSrc",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "src"
          },
          {
            "$": "src"
          },
          {
            "op": "at",
            "args": [
              {
                "$": "PLACEHOLDER"
              },
              "light"
            ]
          }
        ]
      }
    },
    {
      "name": "nightSrc",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "darkSrc"
          },
          {
            "$": "darkSrc"
          },
          {
            "op": "cond",
            "args": [
              {
                "$": "src"
              },
              {
                "$": "src"
              },
              {
                "op": "at",
                "args": [
                  {
                    "$": "PLACEHOLDER"
                  },
                  "dark"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "shownAlt",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "src"
          },
          {
            "$": "alt"
          },
          ""
        ]
      }
    },
    {
      "name": "loadHint",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "src"
          },
          "lazy",
          {
            "op": "undef",
            "args": []
          }
        ]
      }
    },
    {
      "name": "decodeHint",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "src"
          },
          "async",
          {
            "op": "undef",
            "args": []
          }
        ]
      }
    },
    {
      "name": "lightSet",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "$": "src"
              },
              {
                "$": "srcset"
              }
            ]
          },
          {
            "$": "srcset"
          },
          {
            "op": "undef",
            "args": []
          }
        ]
      }
    },
    {
      "name": "nightSet",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "darkSrc"
          },
          {
            "op": "undef",
            "args": []
          },
          {
            "$": "lightSet"
          }
        ]
      }
    },
    {
      "name": "lightSizes",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "lightSet"
          },
          {
            "$": "sizes"
          },
          {
            "op": "undef",
            "args": []
          }
        ]
      }
    },
    {
      "name": "nightSizes",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "nightSet"
          },
          {
            "$": "sizes"
          },
          {
            "op": "undef",
            "args": []
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            {
              "op": "recipe",
              "args": [
                "mediaFrame",
                "ratio",
                {
                  "$": "ratio"
                }
              ]
            },
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "data-slot": "media-frame",
        "data-placeholder": {
          "op": "cond",
          "args": [
            {
              "$": "src"
            },
            "false",
            "true"
          ]
        }
      },
      "children": [
        {
          "use": "Image",
          "props": {
            "Src": {
              "$": "lightSrc"
            },
            "SrcSet": {
              "$": "lightSet"
            },
            "Sizes": {
              "$": "lightSizes"
            },
            "Alt": {
              "$": "shownAlt"
            },
            "Loading": {
              "$": "loadHint"
            },
            "Decoding": {
              "$": "decodeHint"
            },
            "Class": "absolute inset-0 size-full object-cover dark:hidden"
          },
          "attrs": {
            "data-theme-src": "light"
          }
        },
        {
          "use": "Image",
          "props": {
            "Src": {
              "$": "nightSrc"
            },
            "SrcSet": {
              "$": "nightSet"
            },
            "Sizes": {
              "$": "nightSizes"
            },
            "Alt": {
              "$": "shownAlt"
            },
            "Loading": {
              "$": "loadHint"
            },
            "Decoding": {
              "$": "decodeHint"
            },
            "Class": "absolute inset-0 hidden size-full object-cover dark:block"
          },
          "attrs": {
            "data-theme-src": "dark"
          }
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true,
    "vue": true,
    "solid": true,
    "jinja2": true,
    "twig": true,
    "latte": true,
    "templ": true
  },
  "examples": [
    {
      "id": "ratio.16/9",
      "props": {
        "alt": "Picture",
        "ratio": "16/9"
      }
    },
    {
      "id": "ratio.4/3",
      "props": {
        "alt": "Picture",
        "ratio": "4/3"
      }
    },
    {
      "id": "ratio.1/1",
      "props": {
        "alt": "Picture",
        "ratio": "1/1"
      }
    },
    {
      "id": "ratio.3/4",
      "props": {
        "alt": "Picture",
        "ratio": "3/4"
      }
    },
    {
      "id": "ratio.21/9",
      "props": {
        "alt": "Picture",
        "ratio": "21/9"
      }
    }
  ]
}
