{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codegen-x/ui8kit/packages/skins/fonts/font.schema.json",
  "title": "ui8kit skin font",
  "description": "A web font a skin loads while it is on; skins reference it by id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "provider",
    "google",
    "attribution"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "const": "google"
    },
    "google": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+]+:[a-z,]+@[0-9;,.]+$",
      "description": "family:axes for the Google Fonts css2 API, verbatim"
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "license"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    }
  }
}
