{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codegen-x/ui8kit/packages/skins/skins/skin.schema.json",
  "title": "ui8kit skin",
  "description": "One skin: the shadcn tokens of the light and dark themes under data-skin=\"<id>\". `bun run skins build` writes packages/compose-gen/runtimes/core/assets/styles/skins/<id>.css from it. Values are stored verbatim (never recomputed).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "attribution",
    "fonts",
    "comment",
    "scope",
    "bodyTracking",
    "light",
    "dark"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "license"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "where the values come from, as skins.json records it (\"ui8kit\" or \"tweakcn <commit>\")"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "upstream": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        }
      }
    },
    "fonts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "ids of packages/skins/fonts/<id>.json, the Google fonts loaded while the skin is on"
    },
    "comment": {
      "type": "string",
      "description": "the header comment of the CSS file, verbatim (between /* and */)"
    },
    "scope": {
      "enum": [
        "any",
        "root"
      ],
      "description": "any: [data-skin] on <html> or on any element (a tile of /skins/); root: :root[data-skin] only"
    },
    "bodyTracking": {
      "type": "boolean",
      "description": "body letter-spacing follows --tracking-normal"
    },
    "light": {
      "$ref": "#/$defs/tokens"
    },
    "dark": {
      "$ref": "#/$defs/tokens"
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": {
          "$ref": "#/$defs/notes"
        },
        "dark": {
          "$ref": "#/$defs/notes"
        }
      }
    }
  },
  "$defs": {
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/color"
        },
        "foreground": {
          "$ref": "#/$defs/color"
        },
        "card": {
          "$ref": "#/$defs/color"
        },
        "card-foreground": {
          "$ref": "#/$defs/color"
        },
        "popover": {
          "$ref": "#/$defs/color"
        },
        "popover-foreground": {
          "$ref": "#/$defs/color"
        },
        "primary": {
          "$ref": "#/$defs/color"
        },
        "primary-foreground": {
          "$ref": "#/$defs/color"
        },
        "secondary": {
          "$ref": "#/$defs/color"
        },
        "secondary-foreground": {
          "$ref": "#/$defs/color"
        },
        "muted": {
          "$ref": "#/$defs/color"
        },
        "muted-foreground": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "accent-foreground": {
          "$ref": "#/$defs/color"
        },
        "destructive": {
          "$ref": "#/$defs/color"
        },
        "destructive-foreground": {
          "$ref": "#/$defs/color"
        },
        "destructive-hover": {
          "$ref": "#/$defs/color",
          "description": "hover:bg-destructive-hover: --destructive moved 6 lightness points away from --destructive-foreground (skins.ts destructiveHover; `bun run skins build` fails when the stored value differs from it). Kept last in the object: the CSS prints it after the other tokens."
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "input": {
          "$ref": "#/$defs/color"
        },
        "ring": {
          "$ref": "#/$defs/color"
        },
        "chart-1": {
          "$ref": "#/$defs/color"
        },
        "chart-2": {
          "$ref": "#/$defs/color"
        },
        "chart-3": {
          "$ref": "#/$defs/color"
        },
        "chart-4": {
          "$ref": "#/$defs/color"
        },
        "chart-5": {
          "$ref": "#/$defs/color"
        },
        "sidebar": {
          "$ref": "#/$defs/color"
        },
        "sidebar-foreground": {
          "$ref": "#/$defs/color"
        },
        "sidebar-primary": {
          "$ref": "#/$defs/color"
        },
        "sidebar-primary-foreground": {
          "$ref": "#/$defs/color"
        },
        "sidebar-accent": {
          "$ref": "#/$defs/color"
        },
        "sidebar-accent-foreground": {
          "$ref": "#/$defs/color"
        },
        "sidebar-border": {
          "$ref": "#/$defs/color"
        },
        "sidebar-ring": {
          "$ref": "#/$defs/color"
        },
        "font-sans": {
          "$ref": "#/$defs/fontStack"
        },
        "font-serif": {
          "$ref": "#/$defs/fontStack"
        },
        "font-mono": {
          "$ref": "#/$defs/fontStack"
        },
        "font-weight-medium": {
          "$ref": "#/$defs/weight"
        },
        "font-weight-semibold": {
          "$ref": "#/$defs/weight"
        },
        "radius": {
          "$ref": "#/$defs/length"
        },
        "spacing": {
          "$ref": "#/$defs/length"
        },
        "shadow-2xs": {
          "$ref": "#/$defs/shadow"
        },
        "shadow-xs": {
          "$ref": "#/$defs/shadow"
        },
        "shadow-sm": {
          "$ref": "#/$defs/shadow"
        },
        "shadow": {
          "$ref": "#/$defs/shadow"
        },
        "shadow-md": {
          "$ref": "#/$defs/shadow"
        },
        "shadow-lg": {
          "$ref": "#/$defs/shadow"
        },
        "shadow-xl": {
          "$ref": "#/$defs/shadow"
        },
        "shadow-2xl": {
          "$ref": "#/$defs/shadow"
        },
        "tracking-normal": {
          "$ref": "#/$defs/tracking"
        },
        "tracking-tighter": {
          "$ref": "#/$defs/tracking"
        },
        "tracking-tight": {
          "$ref": "#/$defs/tracking"
        },
        "tracking-wide": {
          "$ref": "#/$defs/tracking"
        },
        "tracking-wider": {
          "$ref": "#/$defs/tracking"
        },
        "tracking-widest": {
          "$ref": "#/$defs/tracking"
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/note"
        },
        "foreground": {
          "$ref": "#/$defs/note"
        },
        "card": {
          "$ref": "#/$defs/note"
        },
        "card-foreground": {
          "$ref": "#/$defs/note"
        },
        "popover": {
          "$ref": "#/$defs/note"
        },
        "popover-foreground": {
          "$ref": "#/$defs/note"
        },
        "primary": {
          "$ref": "#/$defs/note"
        },
        "primary-foreground": {
          "$ref": "#/$defs/note"
        },
        "secondary": {
          "$ref": "#/$defs/note"
        },
        "secondary-foreground": {
          "$ref": "#/$defs/note"
        },
        "muted": {
          "$ref": "#/$defs/note"
        },
        "muted-foreground": {
          "$ref": "#/$defs/note"
        },
        "accent": {
          "$ref": "#/$defs/note"
        },
        "accent-foreground": {
          "$ref": "#/$defs/note"
        },
        "destructive": {
          "$ref": "#/$defs/note"
        },
        "destructive-foreground": {
          "$ref": "#/$defs/note"
        },
        "border": {
          "$ref": "#/$defs/note"
        },
        "input": {
          "$ref": "#/$defs/note"
        },
        "ring": {
          "$ref": "#/$defs/note"
        },
        "chart-1": {
          "$ref": "#/$defs/note"
        },
        "chart-2": {
          "$ref": "#/$defs/note"
        },
        "chart-3": {
          "$ref": "#/$defs/note"
        },
        "chart-4": {
          "$ref": "#/$defs/note"
        },
        "chart-5": {
          "$ref": "#/$defs/note"
        },
        "sidebar": {
          "$ref": "#/$defs/note"
        },
        "sidebar-foreground": {
          "$ref": "#/$defs/note"
        },
        "sidebar-primary": {
          "$ref": "#/$defs/note"
        },
        "sidebar-primary-foreground": {
          "$ref": "#/$defs/note"
        },
        "sidebar-accent": {
          "$ref": "#/$defs/note"
        },
        "sidebar-accent-foreground": {
          "$ref": "#/$defs/note"
        },
        "sidebar-border": {
          "$ref": "#/$defs/note"
        },
        "sidebar-ring": {
          "$ref": "#/$defs/note"
        },
        "font-sans": {
          "$ref": "#/$defs/note"
        },
        "font-serif": {
          "$ref": "#/$defs/note"
        },
        "font-mono": {
          "$ref": "#/$defs/note"
        },
        "font-weight-medium": {
          "$ref": "#/$defs/note"
        },
        "font-weight-semibold": {
          "$ref": "#/$defs/note"
        },
        "radius": {
          "$ref": "#/$defs/note"
        },
        "spacing": {
          "$ref": "#/$defs/note"
        },
        "shadow-2xs": {
          "$ref": "#/$defs/note"
        },
        "shadow-xs": {
          "$ref": "#/$defs/note"
        },
        "shadow-sm": {
          "$ref": "#/$defs/note"
        },
        "shadow": {
          "$ref": "#/$defs/note"
        },
        "shadow-md": {
          "$ref": "#/$defs/note"
        },
        "shadow-lg": {
          "$ref": "#/$defs/note"
        },
        "shadow-xl": {
          "$ref": "#/$defs/note"
        },
        "shadow-2xl": {
          "$ref": "#/$defs/note"
        },
        "tracking-normal": {
          "$ref": "#/$defs/note"
        },
        "tracking-tighter": {
          "$ref": "#/$defs/note"
        },
        "tracking-tight": {
          "$ref": "#/$defs/note"
        },
        "tracking-wide": {
          "$ref": "#/$defs/note"
        },
        "tracking-wider": {
          "$ref": "#/$defs/note"
        },
        "tracking-widest": {
          "$ref": "#/$defs/note"
        }
      },
      "description": "a CSS comment printed before the token"
    },
    "note": {
      "type": "string",
      "pattern": "^/\\*[\\s\\S]*\\*/$"
    },
    "color": {
      "type": "string",
      "pattern": "^hsl\\([^()]*\\)$"
    },
    "fontStack": {
      "type": "string",
      "minLength": 1
    },
    "weight": {
      "type": "string",
      "pattern": "^[1-9]00$"
    },
    "length": {
      "type": "string",
      "pattern": "^(0|\\d*\\.?\\d+(rem|px|em))$"
    },
    "shadow": {
      "type": "string",
      "pattern": "^[^;{}]+$"
    },
    "tracking": {
      "type": "string",
      "pattern": "^[^;{}]+$"
    }
  }
}
